float vwapReclaimDisplayRunProfit = vwapReclaimUseGuard ? vwapReclaimFinalRunProfit : vwapReclaimSurvivedProfitStats
float openingDisplayRunProfit = openingUseGuard ? openingFinalRunProfit : openingSurvivedProfitStats

int protectedClosedStats = buyFinalClosed + buyPlusFinalClosed + pbPlusFinalClosed + rallyFinalClosed + fastFinalClosed + fastEarlyFinalClosed + turnFinalClosed + reboundFinalClosed + vwapReclaimFinalClosed + openingFinalClosed
float protectedProfitStats = buyFinalProfit + buyPlusFinalProfit + pbPlusFinalProfit + rallyFinalProfit + fastFinalProfit + fastEarlyFinalProfit + turnFinalProfit + reboundFinalProfit + vwapReclaimFinalProfit + openingFinalProfit
float protectedQualityWeighted = buyFinalQualityScore * buyFinalClosed + buyPlusFinalQualityScore * buyPlusFinalClosed + pbPlusFinalQualityScore * pbPlusFinalClosed + rallyFinalQualityScore * rallyFinalClosed + fastFinalQualityScore * fastFinalClosed + fastEarlyFinalQualityScore * fastEarlyFinalClosed + turnFinalQualityScore * turnFinalClosed + reboundFinalQualityScore * reboundFinalClosed + vwapReclaimFinalQualityScore * vwapReclaimFinalClosed + openingFinalQualityScore * openingFinalClosed
int protectedQualityScore = protectedClosedStats > 0 ? math.round(protectedQualityWeighted / protectedClosedStats) : 0
float protectedAvgProfitStats = protectedClosedStats > 0 ? protectedProfitStats / protectedClosedStats : 0.0
int protectedEntryStats = buyFinalEntries + buyPlusFinalEntries + pbPlusFinalEntries + rallyFinalEntries + fastFinalEntries + fastEarlyFinalEntries + turnFinalEntries + reboundFinalEntries + vwapReclaimFinalEntries + openingFinalEntries
int protectedEarlyStopStats = buyFinalStops + buyPlusFinalStops + pbPlusFinalStops + rallyFinalStops + fastFinalStops + fastEarlyFinalStops + turnFinalStops + reboundFinalStops + vwapReclaimFinalStops + openingFinalStops
float protectedEarlyStopRate = protectedEntryStats > 0 ? (protectedEarlyStopStats * 1.0 / protectedEntryStats) * 100 : 0.0
int protectedSurvivedStats = buyFinalRuns + buyPlusFinalRuns + pbPlusFinalRuns + rallyFinalRuns + fastFinalRuns + fastEarlyFinalRuns + turnFinalRuns + reboundFinalRuns + vwapReclaimFinalRuns + openingFinalRuns
float protectedSurvivedProfitStats = buyFinalRunProfit + buyPlusFinalRunProfit + pbPlusFinalRunProfit + rallyFinalRunProfit + fastFinalRunProfit + fastEarlyFinalRunProfit + turnFinalRunProfit + reboundFinalRunProfit + vwapReclaimFinalRunProfit + openingFinalRunProfit
float protectedAvgRunStats = protectedSurvivedStats > 0 ? protectedSurvivedProfitStats / protectedSurvivedStats : 0.0
int guardCandidateBlockedLosses = buyGuardRemoved + buyPlusGuardRemoved + pbPlusGuardRemoved + rallyGuardRemoved + fastGuardRemoved + turnGuardRemoved + reboundGuardRemoved + openingGuardRemoved + fastEarlyGuardRemoved + vwapReclaimGuardRemoved
int guardBlockedLosses = (buyUseGuard ? buyGuardRemoved : 0) + (buyPlusUseGuard ? buyPlusGuardRemoved : 0) + (pbPlusUseGuard ? pbPlusGuardRemoved : 0) + (rallyUseGuard ? rallyGuardRemoved : 0) + (fastUseGuard ? fastGuardRemoved : 0) + (turnUseGuard ? turnGuardRemoved : 0) + (reboundUseGuard ? reboundGuardRemoved : 0) + (openingUseGuard and openingFinalGateOk ? openingGuardRemoved : 0) + (fastEarlyUseGuard ? fastEarlyGuardRemoved : 0) + (vwapReclaimUseGuard and vwapReclaimFinalGateOk ? vwapReclaimGuardRemoved : 0)
float guardAvgImprovement = protectedAvgProfitStats - teamAvgProfitStats
int guardAddedTactics = (not buyStatsGateOk and buyFinalGateOk ? 1 : 0) + (not buyPlusStatsGateOk and buyPlusFinalGateOk ? 1 : 0) + (not pbPlusStatsGateOk and pbPlusFinalGateOk ? 1 : 0) + (not rallyStatsGateOk and rallyFinalGateOk ? 1 : 0) + (not fastStatsGateOk and fastFinalGateOk ? 1 : 0) + (not turnStatsGateOk and turnFinalGateOk ? 1 : 0) + (not reboundStatsGateOk and reboundFinalGateOk ? 1 : 0) + (not openingStatsGateOk and openingFinalGateOk ? 1 : 0) + (not fastEarlyStatsGateOk and fastEarlyFinalGateOk ? 1 : 0) + (not vwapReclaimStatsGateOk and vwapReclaimFinalGateOk ? 1 : 0)
int guardUsedTactics = (buyUseGuard ? 1 : 0) + (buyPlusUseGuard ? 1 : 0) + (pbPlusUseGuard ? 1 : 0) + (rallyUseGuard ? 1 : 0) + (fastUseGuard ? 1 : 0) + (turnUseGuard ? 1 : 0) + (reboundUseGuard ? 1 : 0) + (openingUseGuard and openingFinalGateOk ? 1 : 0) + (fastEarlyUseGuard ? 1 : 0) + (vwapReclaimUseGuard and vwapReclaimFinalGateOk ? 1 : 0)
int protectedFitScore = f_pb_auto_fit_score(protectedQualityScore, protectedAvgProfitStats, protectedAvgRunStats, protectedEarlyStopRate, protectedClosedStats, protectedAvgProfitStats, totalAvgProfitStats, tfMinutesForAutoFit)
int protectedFitDelta = protectedFitScore - pbAutoFitScore
string protectedBaseLabel = protectedFitScore >= 90 ? "Elite" : protectedFitScore >= 80 ? "Fit" : protectedFitScore >= 70 ? "Watch" : "No"
string protectedFitLabel = protectedClosedStats <= 0 ? "No Data" : guardUsedTactics > 0 ? "Guard " + protectedBaseLabel : protectedBaseLabel
color protectedFitColor = protectedClosedStats <= 0 ? color.white : protectedFitScore >= 80 ? color.lime : protectedFitScore >= 70 ? color.yellow : color.red
color protectedFitBg = protectedClosedStats <= 0 ? color.rgb(70, 70, 70) : protectedFitScore >= 80 ? color.rgb(14, 92, 54) : protectedFitScore >= 70 ? color.rgb(90, 80, 20) : color.rgb(92, 30, 36)
string guardAddedList = ""
guardAddedList := guardAddedList + (buyUseGuard ? "BUY " : "")
guardAddedList := guardAddedList + (buyPlusUseGuard ? "BUY+ " : "")
guardAddedList := guardAddedList + (pbPlusUseGuard ? "PB+ " : "")
guardAddedList := guardAddedList + (rallyUseGuard ? "RALLY " : "")
guardAddedList := guardAddedList + (fastUseGuard ? "FAST " : "")
guardAddedList := guardAddedList + (turnUseGuard ? "TURN " : "")
guardAddedList := guardAddedList + (reboundUseGuard ? "REB " : "")
guardAddedList := guardAddedList + (openingUseGuard and openingFinalGateOk ? "RS PB+ " : "")
guardAddedList := guardAddedList + (fastEarlyUseGuard ? "FAST E " : "")
guardAddedList := guardAddedList + (vwapReclaimUseGuard and vwapReclaimFinalGateOk ? "RS PB " : "")
guardAddedList := guardUsedTactics > 0 ? guardAddedList : "None"
string protectedFitDeltaText = (protectedFitDelta > 0 ? "+" : "") + str.tostring(protectedFitDelta)
string guardActionText = guardBlockedLosses > 0 ? "Block " + str.tostring(guardBlockedLosses) : "Adds " + str.tostring(guardAddedTactics)
string guardDetailText = guardUsedTactics > 0 ? guardAddedList : guardAddedTactics > 0 ? "Adds " + str.tostring(guardAddedTactics) : "None"

int finalOperationalEntryIndex = -1
float finalOperationalBestQuality = -1.0
float finalOperationalBestNetPerTrade = -999999.0
if pendingEntryCount > 0 and not falsePressureAutoBlocked
    for j = 0 to pendingEntryCount - 1
        string candidateType = array.get(pendingEntryTypes, j)
        bool candidateFinalGate = candidateType == "BUY" ? buyFinalGateOk : candidateType == "BUY_PLUS" ? buyPlusFinalGateOk : candidateType == "PB_PLUS" ? pbPlusFinalGateOk : candidateType == "RALLY_BUY" ? rallyFinalGateOk : candidateType == "FAST_MOMENTUM_BUY" ? fastFinalGateOk : candidateType == "FAST_EARLY_BUY" ? fastEarlyFinalGateOk : candidateType == "TEN_MIN_TURN_BUY" ? turnFinalGateOk : candidateType == "EARLY_REBOUND_BUY" ? reboundFinalGateOk : candidateType == "VWAP_RECLAIM_BUY" ? vwapReclaimFinalGateOk : (candidateType == "OPENING_RANGE_RECLAIM" or candidateType == "OPENING_DRIVE_EXCEPTION") ? openingFinalGateOk : false
        if candidateFinalGate
            int candidateQuality = candidateType == "BUY" ? buyFinalQualityScore : candidateType == "BUY_PLUS" ? buyPlusFinalQualityScore : candidateType == "PB_PLUS" ? pbPlusFinalQualityScore : candidateType == "RALLY_BUY" ? rallyFinalQualityScore : candidateType == "FAST_MOMENTUM_BUY" ? fastFinalQualityScore : candidateType == "FAST_EARLY_BUY" ? fastEarlyFinalQualityScore : candidateType == "TEN_MIN_TURN_BUY" ? turnFinalQualityScore : candidateType == "EARLY_REBOUND_BUY" ? reboundFinalQualityScore : candidateType == "VWAP_RECLAIM_BUY" ? vwapReclaimFinalQualityScore : (candidateType == "OPENING_RANGE_RECLAIM" or candidateType == "OPENING_DRIVE_EXCEPTION") ? openingFinalQualityScore : 0
            int candidateClosed = candidateType == "BUY" ? buyFinalClosed : candidateType == "BUY_PLUS" ? buyPlusFinalClosed : candidateType == "PB_PLUS" ? pbPlusFinalClosed : candidateType == "RALLY_BUY" ? rallyFinalClosed : candidateType == "FAST_MOMENTUM_BUY" ? fastFinalClosed : candidateType == "FAST_EARLY_BUY" ? fastEarlyFinalClosed : candidateType == "TEN_MIN_TURN_BUY" ? turnFinalClosed : candidateType == "EARLY_REBOUND_BUY" ? reboundFinalClosed : candidateType == "VWAP_RECLAIM_BUY" ? vwapReclaimFinalClosed : (candidateType == "OPENING_RANGE_RECLAIM" or candidateType == "OPENING_DRIVE_EXCEPTION") ? openingFinalClosed : 0
            float candidateNet = candidateType == "BUY" ? buyFinalProfit : candidateType == "BUY_PLUS" ? buyPlusFinalProfit : candidateType == "PB_PLUS" ? pbPlusFinalProfit : candidateType == "RALLY_BUY" ? rallyFinalProfit : candidateType == "FAST_MOMENTUM_BUY" ? fastFinalProfit : candidateType == "FAST_EARLY_BUY" ? fastEarlyFinalProfit : candidateType == "TEN_MIN_TURN_BUY" ? turnFinalProfit : candidateType == "EARLY_REBOUND_BUY" ? reboundFinalProfit : candidateType == "VWAP_RECLAIM_BUY" ? vwapReclaimFinalProfit : (candidateType == "OPENING_RANGE_RECLAIM" or candidateType == "OPENING_DRIVE_EXCEPTION") ? openingFinalProfit : 0.0
            float candidateNetPerTrade = candidateClosed > 0 ? candidateNet / candidateClosed : -999999.0
            bool candidateIsBetter = finalOperationalEntryIndex < 0 or candidateQuality > finalOperationalBestQuality or (candidateQuality == finalOperationalBestQuality and candidateNetPerTrade > finalOperationalBestNetPerTrade)
            if candidateIsBetter
                finalOperationalEntryIndex := j
                finalOperationalBestQuality := candidateQuality
                finalOperationalBestNetPerTrade := candidateNetPerTrade

[selectedPayloadEntries, selectedPayloadClosed, selectedPayloadWins, selectedPayloadNet, selectedPayloadStops, selectedPayloadSurvived, selectedPayloadSurvivedProfit] = f_selected_window_metrics()
selectedClosedStats := selectedPayloadClosed
selectedWinRateStats := selectedPayloadClosed > 0 ? (selectedPayloadWins * 1.0 / selectedPayloadClosed) * 100 : 0.0
selectedProfitStats := selectedPayloadNet
selectedEntryStats := selectedPayloadEntries
selectedEarlyStopStats := selectedPayloadStops
selectedEarlyStopRate := selectedEntryStats > 0 ? (selectedEarlyStopStats * 1.0 / selectedEntryStats) * 100 : 0.0
selectedSurvivedStats := selectedPayloadSurvived
selectedSurvivedProfitStats := selectedPayloadSurvivedProfit
selectedQualityScore := f_quality_score(selectedWinRateStats, selectedProfitStats, selectedSurvivedProfitStats, selectedEarlyStopRate, selectedClosedStats)
selectedAvgProfitStats := selectedClosedStats > 0 ? selectedProfitStats / selectedClosedStats : 0.0
selectedAvgRunStats := selectedSurvivedStats > 0 ? selectedSurvivedProfitStats / selectedSurvivedStats : 0.0

// === Webhook JSON Payload ===
f_bool(x) => x ? "true" : "false"
f_num(x) => str.tostring(nz(x, 0), "#.####")
f_time_utc() => str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
f_time_utc_from(int t) => t > 0 ? str.format_time(t, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") : ""

f_entry_stats_key(string entryType) =>
    entryType == "BUY" ? "BUY" : entryType == "BUY_PLUS" ? "BUY_PLUS" : entryType == "PB_PLUS" ? "PB_PLUS" : (entryType == "RALLY_BUY" or entryType == "RALLY_RECOVERY_PB") ? "RALLY" : entryType == "FAST_MOMENTUM_BUY" ? "FAST" : entryType == "FAST_EARLY_BUY" ? "FAST_EARLY" : entryType == "TEN_MIN_TURN_BUY" ? "TURN" : entryType == "EARLY_REBOUND_BUY" ? "EARLY_REBOUND_BUY" : entryType == "VWAP_RECLAIM_BUY" ? "VWAP_RECLAIM" : (entryType == "OPENING_RANGE_RECLAIM" or entryType == "OPENING_DRIVE_EXCEPTION") ? "OPEN" : "NONE"

f_stats_gate_passed(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalGateOk : statsSignalKey == "BUY_PLUS" ? buyPlusFinalGateOk : statsSignalKey == "PB_PLUS" ? pbPlusFinalGateOk : statsSignalKey == "RALLY" ? rallyFinalGateOk : statsSignalKey == "FAST" ? fastFinalGateOk : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalGateOk : statsSignalKey == "TURN" ? turnFinalGateOk : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalGateOk : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalGateOk : statsSignalKey == "OPEN" ? openingFinalGateOk : false

f_signal_final_quality(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalQualityScore : statsSignalKey == "BUY_PLUS" ? buyPlusFinalQualityScore : statsSignalKey == "PB_PLUS" ? pbPlusFinalQualityScore : statsSignalKey == "RALLY" ? rallyFinalQualityScore : statsSignalKey == "FAST" ? fastFinalQualityScore : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalQualityScore : statsSignalKey == "TURN" ? turnFinalQualityScore : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalQualityScore : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalQualityScore : statsSignalKey == "OPEN" ? openingFinalQualityScore : 0

f_signal_final_closed(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalClosed : statsSignalKey == "BUY_PLUS" ? buyPlusFinalClosed : statsSignalKey == "PB_PLUS" ? pbPlusFinalClosed : statsSignalKey == "RALLY" ? rallyFinalClosed : statsSignalKey == "FAST" ? fastFinalClosed : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalClosed : statsSignalKey == "TURN" ? turnFinalClosed : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalClosed : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalClosed : statsSignalKey == "OPEN" ? openingFinalClosed : 0

f_signal_final_win_rate(string statsSignalKey) =>
    statsSignalKey == "BUY" ? (buyUseGuard ? buyGuardWinRate : buyWinRateStats) : statsSignalKey == "BUY_PLUS" ? (buyPlusUseGuard ? buyPlusGuardWinRate : buyPlusWinRateStats) : statsSignalKey == "PB_PLUS" ? (pbPlusUseGuard ? pbPlusGuardWinRate : pbPlusWinRateStats) : statsSignalKey == "RALLY" ? (rallyUseGuard ? rallyGuardWinRate : rallyWinRateStats) : statsSignalKey == "FAST" ? (fastUseGuard ? fastGuardWinRate : fastWinRateStats) : statsSignalKey == "FAST_EARLY" ? (fastEarlyUseGuard ? fastEarlyGuardWinRate : fastEarlyWinRateStats) : statsSignalKey == "TURN" ? (turnUseGuard ? turnGuardWinRate : turnWinRateStats) : statsSignalKey == "EARLY_REBOUND_BUY" ? (reboundUseGuard ? reboundGuardWinRate : reboundWinRateStats) : statsSignalKey == "VWAP_RECLAIM" ? (vwapReclaimUseGuard ? vwapReclaimGuardWinRate : vwapReclaimWinRateStats) : statsSignalKey == "OPEN" ? (openingUseGuard ? openingGuardWinRate : openingWinRate) : 0.0

f_signal_final_net(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalProfit : statsSignalKey == "BUY_PLUS" ? buyPlusFinalProfit : statsSignalKey == "PB_PLUS" ? pbPlusFinalProfit : statsSignalKey == "RALLY" ? rallyFinalProfit : statsSignalKey == "FAST" ? fastFinalProfit : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalProfit : statsSignalKey == "TURN" ? turnFinalProfit : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalProfit : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalProfit : statsSignalKey == "OPEN" ? openingFinalProfit : 0.0

f_signal_guard_used(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyUseGuard : statsSignalKey == "BUY_PLUS" ? buyPlusUseGuard : statsSignalKey == "PB_PLUS" ? pbPlusUseGuard : statsSignalKey == "RALLY" ? rallyUseGuard : statsSignalKey == "FAST" ? fastUseGuard : statsSignalKey == "FAST_EARLY" ? fastEarlyUseGuard : statsSignalKey == "TURN" ? turnUseGuard : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundUseGuard : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimUseGuard : statsSignalKey == "OPEN" ? openingUseGuard : false

f_signal_stats_entries(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalEntries : statsSignalKey == "BUY_PLUS" ? buyPlusFinalEntries : statsSignalKey == "PB_PLUS" ? pbPlusFinalEntries : statsSignalKey == "RALLY" ? rallyFinalEntries : statsSignalKey == "FAST" ? fastFinalEntries : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalEntries : statsSignalKey == "TURN" ? turnFinalEntries : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalEntries : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalEntries : statsSignalKey == "OPEN" ? openingFinalEntries : 0

f_signal_stats_early_stops(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalStops : statsSignalKey == "BUY_PLUS" ? buyPlusFinalStops : statsSignalKey == "PB_PLUS" ? pbPlusFinalStops : statsSignalKey == "RALLY" ? rallyFinalStops : statsSignalKey == "FAST" ? fastFinalStops : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalStops : statsSignalKey == "TURN" ? turnFinalStops : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalStops : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalStops : statsSignalKey == "OPEN" ? openingFinalStops : 0

f_signal_stats_run_count(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalRuns : statsSignalKey == "BUY_PLUS" ? buyPlusFinalRuns : statsSignalKey == "PB_PLUS" ? pbPlusFinalRuns : statsSignalKey == "RALLY" ? rallyFinalRuns : statsSignalKey == "FAST" ? fastFinalRuns : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalRuns : statsSignalKey == "TURN" ? turnFinalRuns : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalRuns : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalRuns : statsSignalKey == "OPEN" ? openingFinalRuns : 0

f_signal_stats_stop_rate(string statsSignalKey) =>
    int finalEntries = f_signal_stats_entries(statsSignalKey)
    int finalStops = f_signal_stats_early_stops(statsSignalKey)
    finalEntries > 0 ? (finalStops * 1.0 / finalEntries) * 100 : 0.0

f_signal_stats_run(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyFinalRunProfit : statsSignalKey == "BUY_PLUS" ? buyPlusFinalRunProfit : statsSignalKey == "PB_PLUS" ? pbPlusFinalRunProfit : statsSignalKey == "RALLY" ? rallyFinalRunProfit : statsSignalKey == "FAST" ? fastFinalRunProfit : statsSignalKey == "FAST_EARLY" ? fastEarlyFinalRunProfit : statsSignalKey == "TURN" ? turnFinalRunProfit : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundFinalRunProfit : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimFinalRunProfit : statsSignalKey == "OPEN" ? openingFinalRunProfit : 0.0

f_signal_stats_best_trade(string statsSignalKey) =>
    statsSignalKey == "BUY" ? buyBestTradeStats : statsSignalKey == "BUY_PLUS" ? buyPlusBestTradeStats : statsSignalKey == "PB_PLUS" ? pbPlusBestTradeStats : statsSignalKey == "RALLY" ? rallyBestTradeStats : statsSignalKey == "FAST" ? fastBestTradeStats : statsSignalKey == "FAST_EARLY" ? fastEarlyBestTradeStats : statsSignalKey == "TURN" ? turnBestTradeStats : statsSignalKey == "EARLY_REBOUND_BUY" ? reboundBestTradeStats : statsSignalKey == "VWAP_RECLAIM" ? vwapReclaimBestTradeStats : statsSignalKey == "OPEN" ? openingBestTradeStats : 0.0

f_signal_stats_payload(string statsSignalKey, int signalStatsQuality, int signalStatsClosed, int signalStatsEntries, int signalStatsEarlyStops, int signalStatsRunCount, float signalStatsWinRate, float signalStatsNet, float signalStatsStopRate, float signalStatsRun, float signalStatsBestTrade, bool signalStatsGuardUsed, bool signalStatsGatePassed) =>
    float signalStatsNetWithoutBest = f_net_without_best(signalStatsNet, signalStatsBestTrade)
    float signalStatsBestTradeShare = f_best_trade_share(signalStatsNet, signalStatsBestTrade)
    string statsJson = ""
    statsJson += "\"signalStatsKey\":\"" + statsSignalKey + "\","
    statsJson += "\"signalStatsQuality\":" + str.tostring(signalStatsQuality) + ","
    statsJson += "\"signalStatsClosed\":" + str.tostring(signalStatsClosed) + ","
    statsJson += "\"signalStatsEntries\":" + str.tostring(signalStatsEntries) + ","
    statsJson += "\"signalStatsWinRatePct\":" + f_num(signalStatsWinRate) + ","
    statsJson += "\"signalStatsNetPct\":" + f_num(signalStatsNet) + ","
    statsJson += "\"signalStatsBestTradePct\":" + f_num(signalStatsBestTrade) + ","
    statsJson += "\"signalStatsNetWithoutBestPct\":" + f_num(signalStatsNetWithoutBest) + ","
    statsJson += "\"signalStatsBestTradeSharePct\":" + f_num(signalStatsBestTradeShare) + ","
    statsJson += "\"statsGateMaxBestTradeSharePct\":" + f_num(statsGateMaxBestTradeSharePct) + ","
    statsJson += "\"signalStatsStopPct\":" + f_num(signalStatsStopRate) + ","
    statsJson += "\"signalStatsStopCount\":" + str.tostring(signalStatsEarlyStops) + ","
    statsJson += "\"signalStatsRunPct\":" + f_num(signalStatsRun) + ","
    statsJson += "\"signalStatsRunCount\":" + str.tostring(signalStatsRunCount) + ","
    statsJson += "\"signalStatsGuardUsed\":" + f_bool(signalStatsGuardUsed) + ","
    statsJson += "\"signalStatsGatePassed\":" + f_bool(signalStatsGatePassed) + ","
    statsJson

f_core_payload(string sig, float prc, string payloadEntryId, string payloadEntryType, float payloadEntryPrice, int payloadEntryTime, int payloadEntryBar, float payloadExitPrice, float payloadExitProfitPct, int payloadBatchCount) =>
    string coreJson = ""
    coreJson += "\"signal\":\"" + sig + "\","
    coreJson += "\"ticker\":\"" + syminfo.tickerid + "\","
    coreJson += "\"brokerSymbol\":\"" + syminfo.ticker + "\","
    coreJson += "\"timeframe\":\"" + timeframe.period + "\","
    coreJson += "\"utcTime\":\"" + f_time_utc() + "\","
    coreJson += "\"price\":" + f_num(prc) + ","
    coreJson += "\"entryId\":\"" + payloadEntryId + "\","
    coreJson += "\"entryType\":\"" + payloadEntryType + "\","
    coreJson += "\"entryPrice\":" + f_num(payloadEntryPrice) + ","
    coreJson += "\"entryTime\":\"" + f_time_utc_from(payloadEntryTime) + "\","
    coreJson += "\"entryTimeUnix\":" + str.tostring(payloadEntryTime) + ","
    coreJson += "\"entryBarIndex\":" + str.tostring(payloadEntryBar) + ","
    coreJson += "\"exitPrice\":" + f_num(payloadExitPrice) + ","
    coreJson += "\"exitProfitPct\":" + f_num(payloadExitProfitPct) + ","
    coreJson += "\"exitBatchCount\":" + str.tostring(payloadBatchCount) + ","
    coreJson += "\"estRoundTripCostPct\":" + f_num(estRoundTripCostPct) + ","
    coreJson

f_auto_execution_payload(string action, bool executable, string gateName) =>
    string autoJson = ""
    autoJson += "\"autoAction\":\"" + action + "\","
    autoJson += "\"autoExecutable\":" + f_bool(executable) + ","
    autoJson += "\"autoGate\":\"" + gateName + "\","
    autoJson

f_signal_context_payload() =>
    string ctxJson = ""
    ctxJson += "\"volumeRatio\":" + f_num(volumeRatio) + ","
    ctxJson += "\"pbScore\":" + f_num(finalScore) + ","
    ctxJson += "\"fastMomentumBuy\":" + f_bool(showFastMomentum) + ","
    ctxJson += "\"fastEarlyBuy\":" + f_bool(showFastEarly) + ","
    ctxJson += "\"fastAtrPct\":" + f_num(fastAtrPct) + ","
    ctxJson += "\"fastClosePosition\":" + f_num(fastClosePosition) + ","
    ctxJson += "\"fastBarGainPct\":" + f_num(fastBarGainPct) + ","
    ctxJson += "\"fastEarlyDistanceFromVwapPct\":" + f_num(fastEarlyDistanceFromVwapPct) + ","
    ctxJson += "\"fastRun5BarsPct\":" + f_num(fastRun5BarsPct) + ","
    ctxJson += "\"fastSpacingOk\":" + f_bool(fastSpacingOk) + ","
    ctxJson += "\"tenMinTurnBuy\":" + f_bool(showTenMinTurn) + ","
    ctxJson += "\"vwapReclaimBuy\":" + f_bool(showVwapReclaim) + ","
    ctxJson += "\"vwapReclaimClosePosition\":" + f_num(vwapReclaimClosePosition) + ","
    ctxJson += "\"vwapReclaimDistancePct\":" + f_num(vwapReclaimDistancePct) + ","
    ctxJson += "\"vwapReclaimSpacingOk\":" + f_bool(vwapReclaimSpacingOk) + ","
    ctxJson += "\"openingRangeReclaim\":" + f_bool(showOpeningDriveException) + ","
    ctxJson += "\"earlyReboundBuy\":" + f_bool(showEarlyRebound) + ","
    ctxJson += "\"earlyReboundBarGainPct\":" + f_num(earlyReboundBarGainPct) + ","
    ctxJson += "\"earlyReboundClosePosition\":" + f_num(earlyReboundClosePosition) + ","
    ctxJson += "\"earlyReboundDistanceFromVwapPct\":" + f_num(earlyReboundDistanceFromVwapPct) + ","
    ctxJson += "\"trendUp\":" + f_bool(trendUp) + ","
    ctxJson += "\"pbPlusBlockedByFilter\":" + f_bool(pbPlusBlockedByFilter) + ","
    ctxJson += "\"rsi\":" + f_num(rsi) + ","
    ctxJson

f_market_context_payload() =>
    string marketMode = isMarketRiskOff ? "RISK_OFF" : qqqDailyTrendUp and qqqTrendUp ? "TREND_SUPPORT" : "NEUTRAL"
    float stockChange5BarsPct = stockChange * 100
    float qqqChange5BarsPct = qqqChange * 100
    float relativeStrength5BarsPct = stockChange5BarsPct - qqqChange5BarsPct
    float distanceFromEma8Pct = ema8 > 0 ? ((close - ema8) / ema8) * 100 : 0.0
    float distanceFromEma21Pct = ema21 > 0 ? ((close - ema21) / ema21) * 100 : 0.0
    float distanceFromVwapPct = vwapVal > 0 ? ((close - vwapVal) / vwapVal) * 100 : 0.0
    float atrPct = close > 0 ? (atr14 / close) * 100 : 0.0
    string marketJson = ""
    marketJson += "\"marketContextVersion\":\"1\","
    marketJson += "\"marketContextPassive\":true,"
    marketJson += "\"marketContextAffectsExecution\":false,"
    marketJson += "\"marketProxy\":\"NASDAQ:QQQ\","
    marketJson += "\"marketMode\":\"" + marketMode + "\","
    marketJson += "\"marketTrendUp\":" + f_bool(qqqTrendUp) + ","
    marketJson += "\"marketDailyTrendUp\":" + f_bool(qqqDailyTrendUp) + ","
    marketJson += "\"stockDailyTrendUp\":" + f_bool(dailyBullContext) + ","
    marketJson += "\"stockAboveEma8\":" + f_bool(close > ema8) + ","
    marketJson += "\"stockAboveEma21\":" + f_bool(close > ema21) + ","
    marketJson += "\"stockAboveVwap\":" + f_bool(close > vwapVal) + ","
    marketJson += "\"ema8SlopeUp\":" + f_bool(ema8 > ema8[1]) + ","
    marketJson += "\"relativeStrength5BarsPct\":" + f_num(relativeStrength5BarsPct) + ","
    marketJson += "\"stockChange5BarsPct\":" + f_num(stockChange5BarsPct) + ","
    marketJson += "\"qqqChange5BarsPct\":" + f_num(qqqChange5BarsPct) + ","
    marketJson += "\"distanceFromEma8Pct\":" + f_num(distanceFromEma8Pct) + ","
    marketJson += "\"distanceFromEma21Pct\":" + f_num(distanceFromEma21Pct) + ","
    marketJson += "\"distanceFromVwapPct\":" + f_num(distanceFromVwapPct) + ","
    marketJson += "\"atrPct\":" + f_num(atrPct) + ","
    marketJson

f_risk_context_payload(float payloadStopPrice, string payloadExitMode) =>
    string riskJson = ""
    riskJson += "\"atrExitStop\":" + f_num(payloadStopPrice) + ","
    riskJson += "\"atrExitMode\":\"" + payloadExitMode + "\","
    riskJson += "\"trailStopPct\":" + f_num(trailStopPct) + ","
    riskJson += "\"antiShakeoutFilter\":" + f_bool(antiShakeoutFilter) + ","
    riskJson += "\"trendStillStrong\":" + f_bool(trendStillStrong) + ","
    riskJson += "\"antiShakeoutOverridesExit\":false,"
    riskJson += "\"dropFromHighPct\":" + f_num(dropFromHigh) + ","
    riskJson += "\"dailyBullContext\":" + f_bool(dailyBullContext) + ","
    riskJson += "\"qqqTrend\":" + f_bool(qqqTrendUp) + ","
    riskJson += "\"qqqDailyTrend\":" + f_bool(qqqDailyTrendUp) + ","
    riskJson += "\"isMarketRiskOff\":" + f_bool(isMarketRiskOff) + ","
    riskJson += "\"isEarningsVeto\":" + f_bool(isEarningsVeto) + ","
    riskJson += "\"isGapRisk\":" + f_bool(isGapRisk) + ","
    riskJson += "\"isAtrSpikeRisk\":" + f_bool(isAtrSpikeRisk) + ","
    riskJson += "\"isHighExecutionRisk\":" + f_bool(isHighExecutionRisk) + ","
    riskJson += "\"daysToEarnings\":" + str.tostring(math.round(daysToEarnings)) + ","
    riskJson += "\"strongerThanMarket\":" + f_bool(isStrongerThanMarket) + ","
    riskJson += "\"chopIndex\":" + f_num(chopIndex) + ","
    riskJson += "\"chopEffectiveLength\":" + str.tostring(chopEffectiveLength) + ","
    riskJson += "\"chopThresholdCrossed\":" + f_bool(chopThresholdCrossed) + ","
    riskJson += "\"chopFilterEnabled\":" + f_bool(enableChopFilter) + ","
    riskJson += "\"chopFilterAutoArmed\":" + f_bool(useChopFilterAuto) + ","
    riskJson += "\"chopBlockActive\":" + f_bool(chopBlockActive) + ","
    riskJson += "\"chopConfidenceScore\":" + str.tostring(chopConfidenceScore) + ","
    riskJson += "\"chopMinConfidence\":" + str.tostring(chopMinConfidence) + ","
    riskJson += "\"chopFlaggedProfitFactor\":" + f_num(chopFlaggedProfitFactor) + ","
    riskJson += "\"chopNormalProfitFactor\":" + f_num(chopNormalProfitFactor) + ","
    riskJson

f_selected_total_stats_payload() =>
    string statsJson = ""
    statsJson += "\"selectedStatsQuality\":" + str.tostring(selectedQualityScore) + ","
    statsJson += "\"selectedStatsClosed\":" + str.tostring(selectedClosedStats) + ","
    statsJson += "\"selectedStatsEntries\":" + str.tostring(selectedEntryStats) + ","
    statsJson += "\"selectedStatsNetPct\":" + f_num(selectedProfitStats) + ","
    statsJson += "\"selectedStatsStopPct\":" + f_num(selectedEarlyStopRate) + ","
    statsJson += "\"selectedStatsStopCount\":" + str.tostring(selectedEarlyStopStats) + ","
    statsJson += "\"selectedStatsRunPct\":" + f_num(selectedSurvivedProfitStats) + ","
    statsJson += "\"selectedStatsRunCount\":" + str.tostring(selectedSurvivedStats) + ","
    statsJson += "\"teamStatsQuality\":" + str.tostring(protectedQualityScore) + ","
    statsJson += "\"teamStatsClosed\":" + str.tostring(protectedClosedStats) + ","
    statsJson += "\"teamStatsEntries\":" + str.tostring(protectedEntryStats) + ","
    statsJson += "\"teamStatsNetPct\":" + f_num(protectedProfitStats) + ","
    statsJson += "\"teamStatsStopPct\":" + f_num(protectedEarlyStopRate) + ","
    statsJson += "\"teamStatsStopCount\":" + str.tostring(protectedEarlyStopStats) + ","
    statsJson += "\"teamStatsRunPct\":" + f_num(protectedSurvivedProfitStats) + ","
    statsJson += "\"teamStatsRunCount\":" + str.tostring(protectedSurvivedStats) + ","
    statsJson += "\"teamFitScore\":" + str.tostring(protectedFitScore) + ","
    statsJson += "\"totalStatsQuality\":" + str.tostring(totalQualityScore) + ","
    statsJson += "\"totalStatsClosed\":" + str.tostring(totalClosedStats) + ","
    statsJson += "\"totalStatsNetPct\":" + f_num(totalProfitStats) + ","
    statsJson += "\"totalStatsStopPct\":" + f_num(totalEarlyStopRate) + ","
    statsJson += "\"totalStatsRunPct\":" + f_num(totalSurvivedProfitStats) + ","
    statsJson += "\"selectedFalsePressureLabel\":\"" + falsePressureLabel + "\","
    statsJson += "\"selectedFalsePressureLatched\":" + f_bool(falsePressureLatched) + ","
    statsJson += "\"selectedFalsePressureCleanSweep\":" + f_bool(falsePressureCleanSweep) + ","
    statsJson += "\"selectedFalsePressureProfitFactor\":" + f_num(falsePressureProfitFactor) + ","
    statsJson += "\"selectedFalsePressureAutoBlocked\":" + f_bool(falsePressureAutoBlocked) + ","
    statsJson += "\"selectedFalsePressureLookbackDays\":" + str.tostring(falsePressureLookbackDays) + ","
    statsJson += "\"selectedFalsePressureClosed\":" + str.tostring(falsePressureClosedRecent) + ","
    statsJson += "\"selectedFalsePressureLosses\":" + str.tostring(falsePressureLossRecent) + ","
    statsJson += "\"selectedFalsePressureFalseSignals\":" + str.tostring(falsePressureFalseRecent) + ","
    statsJson += "\"selectedFalsePressureRedMarketEvents\":" + str.tostring(falsePressureRedRecent) + ","
    statsJson += "\"selectedFalsePressureNetPct\":" + f_num(falsePressureNetRecent) + ","
    statsJson += "\"selectedFalsePressureScore\":" + f_num(falsePressureScore) + ","
    statsJson += "\"selectedFalsePressureExcludedTactic1\":\"" + falsePressureWeakKey1 + "\","
    statsJson += "\"selectedFalsePressureExcludedTactic2\":\"" + falsePressureWeakKey2 + "\""
    statsJson

// === Webhook Alert Engine - ATR Exit Safe Version ===
if enableWebhookAlerts and barstate.isconfirmed
    bool entryAlertSent = false
    int pendingExitAlertCount = array.size(pendingAlertSignals)

    if pendingExitAlertCount > 0
        for j = 0 to pendingExitAlertCount - 1
            string pendingSignal = array.get(pendingAlertSignals, j)
            bool pendingAlertAllowed = pendingSignal == "FALSE_BREAKOUT" ? alertFalseBreakoutSignals : alertExitSignals
            string pendingExitFingerprint = pendingSignal + "|" + array.get(pendingAlertEntryIds, j) + "|" + str.tostring(time)
            bool pendingExitNotDuplicate = pendingExitFingerprint != lastAlertFingerprint
            if pendingAlertAllowed and pendingExitNotDuplicate
                string pendingEntryType = array.get(pendingAlertEntryTypes, j)
                string pendingStatsKey = f_entry_stats_key(pendingEntryType)
                int pendingStatsQuality = f_signal_final_quality(pendingStatsKey)
                int pendingStatsClosed = f_signal_final_closed(pendingStatsKey)
                int pendingStatsEntries = f_signal_stats_entries(pendingStatsKey)
                int pendingStatsEarlyStops = f_signal_stats_early_stops(pendingStatsKey)
                int pendingStatsRunCount = f_signal_stats_run_count(pendingStatsKey)
                float pendingStatsWinRate = f_signal_final_win_rate(pendingStatsKey)
                float pendingStatsNet = f_signal_final_net(pendingStatsKey)
                float pendingStatsStopRate = f_signal_stats_stop_rate(pendingStatsKey)
                float pendingStatsRun = f_signal_stats_run(pendingStatsKey)
                float pendingStatsBestTrade = f_signal_stats_best_trade(pendingStatsKey)
                bool pendingStatsGuardUsed = f_signal_guard_used(pendingStatsKey)
                bool pendingStatsGatePassed = f_stats_gate_passed(pendingStatsKey)
                string pendingJson = "{"
                pendingJson += f_core_payload(pendingSignal, array.get(pendingAlertExitPrices, j), array.get(pendingAlertEntryIds, j), pendingEntryType, array.get(pendingAlertEntryPrices, j), array.get(pendingAlertEntryTimes, j), array.get(pendingAlertEntryBars, j), array.get(pendingAlertExitPrices, j), array.get(pendingAlertExitProfitPcts, j), pendingExitAlertCount)
                pendingJson += f_auto_execution_payload("EXIT", true, pendingStatsKey)
                pendingJson += f_signal_context_payload()
                pendingJson += f_market_context_payload()
                pendingJson += f_risk_context_payload(array.get(pendingAlertStopPrices, j), array.get(pendingAlertModes, j))
                pendingJson += f_signal_stats_payload(pendingStatsKey, pendingStatsQuality, pendingStatsClosed, pendingStatsEntries, pendingStatsEarlyStops, pendingStatsRunCount, pendingStatsWinRate, pendingStatsNet, pendingStatsStopRate, pendingStatsRun, pendingStatsBestTrade, pendingStatsGuardUsed, pendingStatsGatePassed)
                pendingJson += f_selected_total_stats_payload()
                pendingJson += "}"
                alert(pendingJson, alert.freq_all)
                lastAlertFingerprint := pendingExitFingerprint

    if finalOperationalEntryIndex >= 0
        int j = finalOperationalEntryIndex
        string entrySignalToSend = array.get(pendingEntrySignals, j)
        string entryTypeToSend = array.get(pendingEntryTypes, j)
        string entryStatsKey = f_entry_stats_key(entryTypeToSend)
        string entryFingerprint = entrySignalToSend + "|" + array.get(pendingEntryIds, j)
        bool entryAutoExecutable = f_stats_gate_passed(entryStatsKey) and not falsePressureAutoBlocked
        bool entryCooldownOk = lastAlertTime == 0 or time - lastAlertTime >= minAlertInterval
        bool entryNotDuplicate = entryCooldownOk and entryFingerprint != lastAlertFingerprint
        if entryAutoExecutable and entryNotDuplicate
            int entryStatsQuality = f_signal_final_quality(entryStatsKey)
            int entryStatsClosed = f_signal_final_closed(entryStatsKey)
            int entryStatsEntries = f_signal_stats_entries(entryStatsKey)
            int entryStatsEarlyStops = f_signal_stats_early_stops(entryStatsKey)
            int entryStatsRunCount = f_signal_stats_run_count(entryStatsKey)
            float entryStatsWinRate = f_signal_final_win_rate(entryStatsKey)
            float entryStatsNet = f_signal_final_net(entryStatsKey)
            float entryStatsStopRate = f_signal_stats_stop_rate(entryStatsKey)
            float entryStatsRun = f_signal_stats_run(entryStatsKey)
            float entryStatsBestTrade = f_signal_stats_best_trade(entryStatsKey)
            bool entryStatsGuardUsed = f_signal_guard_used(entryStatsKey)
            bool entryStatsGatePassed = f_stats_gate_passed(entryStatsKey)
            string entryJson = "{"
            entryJson += f_core_payload(entrySignalToSend, close, array.get(pendingEntryIds, j), entryTypeToSend, array.get(pendingEntryPrices, j), array.get(pendingEntryTimes, j), array.get(pendingEntryBars, j), na, na, pendingEntryCount)
            entryJson += f_auto_execution_payload("BUY", true, entryStatsKey)
            entryJson += f_signal_context_payload()
            entryJson += f_market_context_payload()
            entryJson += f_risk_context_payload(na, "")
            entryJson += f_signal_stats_payload(entryStatsKey, entryStatsQuality, entryStatsClosed, entryStatsEntries, entryStatsEarlyStops, entryStatsRunCount, entryStatsWinRate, entryStatsNet, entryStatsStopRate, entryStatsRun, entryStatsBestTrade, entryStatsGuardUsed, entryStatsGatePassed)
            entryJson += f_selected_total_stats_payload()
            entryJson += "}"
            alert(entryJson, alert.freq_all)
            lastAlertTime := time
            lastAlertFingerprint := entryFingerprint
            entryAlertSent := true
            array.push(entryPrices, array.get(pendingEntryPrices, j))
            array.push(highestPrices, high)
            array.push(entryBars, array.get(pendingEntryBars, j))
            array.push(entryTypes, entryTypeToSend)
            array.push(entryIds, array.get(pendingEntryIds, j))
            array.push(entryMarketContexts, teamMarketContextNow)
            array.push(entryTimes, array.get(pendingEntryTimes, j))
            array.push(runnerActive, false)
            array.push(checkPointMarked, false)
            array.push(redDuringHold, isMarketRiskOff)
            if entryTypeToSend == "OPENING_RANGE_RECLAIM" or entryTypeToSend == "OPENING_DRIVE_EXCEPTION"
                openingDriveActivatedToday := true
            selectedEntryStatsAuto += 1
            array.push(selectedWindowEntryTimes, time)
            selectedEntryStats := array.size(selectedWindowEntryTimes)
    if entryAlertSent
        lastAlertTime := time

// === Table Output ===
var table statsTable = table.new(position.bottom_right, 5, 19, border_width = 1)
var table teamContextTable = table.new(position.top_left, 5, 4, border_width = 1)

if barstate.islast
    color cSectionBg = color.rgb(96, 101, 113)
    color cTotalBg = color.rgb(45, 52, 64)

    // Display-only — see f_unique_days_count comment above. Not used by any gate/quality/execution logic.
    int buyUniqueDays = f_unique_days_count("BUY", buyUseGuard)
    int buyPlusUniqueDays = f_unique_days_count("BUY_PLUS", buyPlusUseGuard)
    int pbPlusUniqueDays = f_unique_days_count("PB_PLUS", pbPlusUseGuard)
    int rallyUniqueDays = f_unique_days_count("RALLY", rallyUseGuard)
    int fastUniqueDays = f_unique_days_count("FAST", fastUseGuard)
    int fastEarlyUniqueDays = f_unique_days_count("FAST_EARLY", fastEarlyUseGuard)
    int turnUniqueDays = f_unique_days_count("TURN", turnUseGuard)
    int reboundUniqueDays = f_unique_days_count("EARLY_REBOUND_BUY", reboundUseGuard)
    int vwapReclaimUniqueDays = f_unique_days_count("VWAP_RECLAIM", vwapReclaimUseGuard)
    int openingUniqueDays = f_unique_days_count("OPEN", openingUseGuard)

    table.cell(statsTable, 0, 0, "PB Live (net " + str.tostring(estRoundTripCostPct, "#.##") + "%)", bgcolor = cSectionBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 0, "Q", bgcolor = color.gray, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 2, 0, "Net", bgcolor = color.gray, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 3, 0, "Stop", bgcolor = color.gray, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 0, "Run", bgcolor = color.gray, text_color = color.white, text_size = size.tiny)

    color cBuyGate = f_gate_color(buyFinalGateOk)
    color cBuyPlusGate = f_gate_color(buyPlusFinalGateOk)
    color cPbPlusGate = f_gate_color(pbPlusFinalGateOk)
    color cRallyGate = f_gate_color(rallyFinalGateOk)
    color cFastGate = f_gate_color(fastFinalGateOk)
    color cFastEarlyGate = f_gate_color(fastEarlyFinalGateOk)
    color cTurnGate = f_gate_color(turnFinalGateOk)
    color cReboundGate = f_gate_color(reboundFinalGateOk)
    color cVwapReclaimGate = f_gate_color(vwapReclaimFinalGateOk)
    color cOpenGate = f_gate_color(openingFinalGateOk)
    color cBuyBg = f_gate_bg(buyFinalGateOk)
    color cBuyPlusBg = f_gate_bg(buyPlusFinalGateOk)
    color cPbPlusBg = f_gate_bg(pbPlusFinalGateOk)
    color cRallyBg = f_gate_bg(rallyFinalGateOk)
    color cFastBg = f_gate_bg(fastFinalGateOk)
    color cFastEarlyBg = f_gate_bg(fastEarlyFinalGateOk)
    color cTurnBg = f_gate_bg(turnFinalGateOk)
    color cReboundBg = f_gate_bg(reboundFinalGateOk)
    color cVwapReclaimBg = f_gate_bg(vwapReclaimFinalGateOk)
    color cOpenBg = f_gate_bg(openingFinalGateOk)
    color cTeam = protectedProfitStats >= 0 ? color.lime : color.red
    color cTeamBg = protectedClosedStats > 0 ? color.rgb(18, 76, 45) : color.rgb(92, 30, 36)
    color cTotal = totalProfitStats >= 0 ? color.lime : color.red

    table.cell(statsTable, 0, 1, "TEAM Fit", bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 1, str.tostring(protectedFitScore) + "/100", bgcolor = protectedFitBg, text_color = protectedFitColor, text_size = size.tiny)
    table.cell(statsTable, 2, 1, protectedFitLabel, bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 3, 1, "", bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 1, "", bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)

    table.cell(statsTable, 0, 2, "TEAM", bgcolor = cTeamBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 2, str.tostring(protectedQualityScore) + "% (" + str.tostring(protectedClosedStats) + ")", bgcolor = cTeamBg, text_color = cTeam, text_size = size.tiny)
    table.cell(statsTable, 2, 2, str.tostring(protectedProfitStats, "#.#") + "%", bgcolor = cTeamBg, text_color = cTeam, text_size = size.tiny)
    table.cell(statsTable, 3, 2, str.tostring(protectedEarlyStopRate, "#.#") + "% (" + str.tostring(protectedEarlyStopStats) + "/" + str.tostring(protectedEntryStats) + ")", bgcolor = cTeamBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 2, str.tostring(protectedSurvivedProfitStats, "#.#") + "% (" + str.tostring(protectedSurvivedStats) + ")", bgcolor = cTeamBg, text_color = cTeam, text_size = size.tiny)

    table.cell(statsTable, 0, 3, "TOTAL", bgcolor = cTotalBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 3, str.tostring(totalQualityScore) + "% (" + str.tostring(totalClosedStats) + ")", bgcolor = cTotalBg, text_color = cTotal, text_size = size.tiny)
    table.cell(statsTable, 2, 3, str.tostring(totalProfitStats, "#.#") + "%", bgcolor = cTotalBg, text_color = cTotal, text_size = size.tiny)
    table.cell(statsTable, 3, 3, str.tostring(totalEarlyStopRate, "#.#") + "% (" + str.tostring(totalEarlyStopStats) + "/" + str.tostring(totalEntryStats) + ")", bgcolor = cTotalBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 3, str.tostring(totalSurvivedProfitStats, "#.#") + "% (" + str.tostring(totalSurvivedStats) + ")", bgcolor = cTotalBg, text_color = cTotal, text_size = size.tiny)

    table.cell(statsTable, 0, 4, "BUY", bgcolor = cBuyBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 4, f_quality_text(buyFinalQualityScore, buyDisplayClosed, not buyFinalGateOk) + " /" + str.tostring(buyUniqueDays) + "d", bgcolor = cBuyBg, text_color = cBuyGate, text_size = size.tiny)
    table.cell(statsTable, 2, 4, str.tostring(buyDisplayProfit, "#.#") + "%", bgcolor = cBuyBg, text_color = cBuyGate, text_size = size.tiny)
    table.cell(statsTable, 3, 4, str.tostring(buyDisplayStopRate, "#.#") + "% (" + str.tostring(buyDisplayStops) + "/" + str.tostring(buyDisplayEntries) + ")", bgcolor = cBuyBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 4, str.tostring(buyDisplayRunProfit, "#.#") + "% (" + str.tostring(buyDisplayRuns) + ")", bgcolor = cBuyBg, text_color = cBuyGate, text_size = size.tiny)

    table.cell(statsTable, 0, 5, "BUY+", bgcolor = cBuyPlusBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 5, f_quality_text(buyPlusFinalQualityScore, buyPlusDisplayClosed, not buyPlusFinalGateOk) + " /" + str.tostring(buyPlusUniqueDays) + "d", bgcolor = cBuyPlusBg, text_color = cBuyPlusGate, text_size = size.tiny)
    table.cell(statsTable, 2, 5, str.tostring(buyPlusDisplayProfit, "#.#") + "%", bgcolor = cBuyPlusBg, text_color = cBuyPlusGate, text_size = size.tiny)
    table.cell(statsTable, 3, 5, str.tostring(buyPlusDisplayStopRate, "#.#") + "% (" + str.tostring(buyPlusDisplayStops) + "/" + str.tostring(buyPlusDisplayEntries) + ")", bgcolor = cBuyPlusBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 5, str.tostring(buyPlusDisplayRunProfit, "#.#") + "% (" + str.tostring(buyPlusDisplayRuns) + ")", bgcolor = cBuyPlusBg, text_color = cBuyPlusGate, text_size = size.tiny)

    table.cell(statsTable, 0, 6, "PB+", bgcolor = cPbPlusBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 6, f_quality_text(pbPlusFinalQualityScore, pbPlusDisplayClosed, not pbPlusFinalGateOk) + " /" + str.tostring(pbPlusUniqueDays) + "d", bgcolor = cPbPlusBg, text_color = cPbPlusGate, text_size = size.tiny)
    table.cell(statsTable, 2, 6, str.tostring(pbPlusDisplayProfit, "#.#") + "%", bgcolor = cPbPlusBg, text_color = cPbPlusGate, text_size = size.tiny)
    table.cell(statsTable, 3, 6, str.tostring(pbPlusDisplayStopRate, "#.#") + "% (" + str.tostring(pbPlusDisplayStops) + "/" + str.tostring(pbPlusDisplayEntries) + ")", bgcolor = cPbPlusBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 6, str.tostring(pbPlusDisplayRunProfit, "#.#") + "% (" + str.tostring(pbPlusDisplayRuns) + ")", bgcolor = cPbPlusBg, text_color = cPbPlusGate, text_size = size.tiny)

    table.cell(statsTable, 0, 7, "RALLY", bgcolor = cRallyBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 7, f_quality_text(rallyFinalQualityScore, rallyDisplayClosed, not rallyFinalGateOk) + " /" + str.tostring(rallyUniqueDays) + "d", bgcolor = cRallyBg, text_color = cRallyGate, text_size = size.tiny)
    table.cell(statsTable, 2, 7, str.tostring(rallyDisplayProfit, "#.#") + "%", bgcolor = cRallyBg, text_color = cRallyGate, text_size = size.tiny)
    table.cell(statsTable, 3, 7, str.tostring(rallyDisplayStopRate, "#.#") + "% (" + str.tostring(rallyDisplayStops) + "/" + str.tostring(rallyDisplayEntries) + ")", bgcolor = cRallyBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 7, str.tostring(rallyDisplayRunProfit, "#.#") + "% (" + str.tostring(rallyDisplayRuns) + ")", bgcolor = cRallyBg, text_color = cRallyGate, text_size = size.tiny)

    table.cell(statsTable, 0, 8, "FAST", bgcolor = cFastBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 8, f_quality_text(fastFinalQualityScore, fastDisplayClosed, not fastFinalGateOk) + " /" + str.tostring(fastUniqueDays) + "d", bgcolor = cFastBg, text_color = cFastGate, text_size = size.tiny)
    table.cell(statsTable, 2, 8, str.tostring(fastDisplayProfit, "#.#") + "%", bgcolor = cFastBg, text_color = cFastGate, text_size = size.tiny)
    table.cell(statsTable, 3, 8, str.tostring(fastDisplayStopRate, "#.#") + "% (" + str.tostring(fastDisplayStops) + "/" + str.tostring(fastDisplayEntries) + ")", bgcolor = cFastBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 8, str.tostring(fastDisplayRunProfit, "#.#") + "% (" + str.tostring(fastDisplayRuns) + ")", bgcolor = cFastBg, text_color = cFastGate, text_size = size.tiny)

    table.cell(statsTable, 0, 9, "FAST E", bgcolor = cFastEarlyBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 9, f_quality_text(fastEarlyFinalQualityScore, fastEarlyDisplayClosed, not fastEarlyFinalGateOk) + " /" + str.tostring(fastEarlyUniqueDays) + "d", bgcolor = cFastEarlyBg, text_color = cFastEarlyGate, text_size = size.tiny)
    table.cell(statsTable, 2, 9, str.tostring(fastEarlyDisplayProfit, "#.#") + "%", bgcolor = cFastEarlyBg, text_color = cFastEarlyGate, text_size = size.tiny)
    table.cell(statsTable, 3, 9, str.tostring(fastEarlyDisplayStopRate, "#.#") + "% (" + str.tostring(fastEarlyDisplayStops) + "/" + str.tostring(fastEarlyDisplayEntries) + ")", bgcolor = cFastEarlyBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 9, str.tostring(fastEarlyDisplayRunProfit, "#.#") + "% (" + str.tostring(fastEarlyDisplayRuns) + ")", bgcolor = cFastEarlyBg, text_color = cFastEarlyGate, text_size = size.tiny)

    table.cell(statsTable, 0, 10, "TURN", bgcolor = cTurnBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 10, f_quality_text(turnFinalQualityScore, turnDisplayClosed, not turnFinalGateOk) + " /" + str.tostring(turnUniqueDays) + "d", bgcolor = cTurnBg, text_color = cTurnGate, text_size = size.tiny)
    table.cell(statsTable, 2, 10, str.tostring(turnDisplayProfit, "#.#") + "%", bgcolor = cTurnBg, text_color = cTurnGate, text_size = size.tiny)
    table.cell(statsTable, 3, 10, str.tostring(turnDisplayStopRate, "#.#") + "% (" + str.tostring(turnDisplayStops) + "/" + str.tostring(turnDisplayEntries) + ")", bgcolor = cTurnBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 10, str.tostring(turnDisplayRunProfit, "#.#") + "% (" + str.tostring(turnDisplayRuns) + ")", bgcolor = cTurnBg, text_color = cTurnGate, text_size = size.tiny)

    table.cell(statsTable, 0, 11, "REB", bgcolor = cReboundBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 11, f_quality_text(reboundFinalQualityScore, reboundDisplayClosed, not reboundFinalGateOk) + " /" + str.tostring(reboundUniqueDays) + "d", bgcolor = cReboundBg, text_color = cReboundGate, text_size = size.tiny)
    table.cell(statsTable, 2, 11, str.tostring(reboundDisplayProfit, "#.#") + "%", bgcolor = cReboundBg, text_color = cReboundGate, text_size = size.tiny)
    table.cell(statsTable, 3, 11, str.tostring(reboundDisplayStopRate, "#.#") + "% (" + str.tostring(reboundDisplayStops) + "/" + str.tostring(reboundDisplayEntries) + ")", bgcolor = cReboundBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 11, str.tostring(reboundDisplayRunProfit, "#.#") + "% (" + str.tostring(reboundDisplayRuns) + ")", bgcolor = cReboundBg, text_color = cReboundGate, text_size = size.tiny)

    table.cell(statsTable, 0, 12, "RS PB", bgcolor = cVwapReclaimBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 12, f_quality_text(vwapReclaimFinalQualityScore, vwapReclaimDisplayClosed, not vwapReclaimFinalGateOk) + " /" + str.tostring(vwapReclaimUniqueDays) + "d", bgcolor = cVwapReclaimBg, text_color = cVwapReclaimGate, text_size = size.tiny)
    table.cell(statsTable, 2, 12, str.tostring(vwapReclaimDisplayProfit, "#.#") + "%", bgcolor = cVwapReclaimBg, text_color = cVwapReclaimGate, text_size = size.tiny)
    table.cell(statsTable, 3, 12, str.tostring(vwapReclaimDisplayStopRate, "#.#") + "% (" + str.tostring(vwapReclaimDisplayStops) + "/" + str.tostring(vwapReclaimDisplayEntries) + ")", bgcolor = cVwapReclaimBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 12, str.tostring(vwapReclaimDisplayRunProfit, "#.#") + "% (" + str.tostring(vwapReclaimDisplayRuns) + ")", bgcolor = cVwapReclaimBg, text_color = cVwapReclaimGate, text_size = size.tiny)

    table.cell(statsTable, 0, 13, "RS PB+", bgcolor = cOpenBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 13, f_quality_text(openingFinalQualityScore, openingDisplayClosed, not openingFinalGateOk) + " /" + str.tostring(openingUniqueDays) + "d", bgcolor = cOpenBg, text_color = cOpenGate, text_size = size.tiny)
    table.cell(statsTable, 2, 13, str.tostring(openingDisplayProfit, "#.#") + "%", bgcolor = cOpenBg, text_color = cOpenGate, text_size = size.tiny)
    table.cell(statsTable, 3, 13, str.tostring(openingDisplayStopRate, "#.#") + "% (" + str.tostring(openingDisplayStops) + "/" + str.tostring(openingDisplayEntries) + ")", bgcolor = cOpenBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 13, str.tostring(openingDisplayRunProfit, "#.#") + "% (" + str.tostring(openingDisplayRuns) + ")", bgcolor = cOpenBg, text_color = cOpenGate, text_size = size.tiny)

    table.cell(statsTable, 0, 14, "GUARD", bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 14, str.tostring(protectedFitScore) + "/100", bgcolor = protectedFitBg, text_color = protectedFitColor, text_size = size.tiny)
    table.cell(statsTable, 2, 14, protectedFitDeltaText, bgcolor = protectedFitBg, text_color = protectedFitColor, text_size = size.tiny)
    table.cell(statsTable, 3, 14, guardActionText, bgcolor = protectedFitBg, text_color = guardCandidateBlockedLosses > 0 ? protectedFitColor : color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 14, guardDetailText, bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)

    table.cell(statsTable, 0, 15, "TEAM FALSE", bgcolor = falsePressureBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 15, falsePressureLabel + " " + str.tostring(falsePressureScore, "#") + "%" + (falsePressureCleanSweep ? " (sweep)" : ""), bgcolor = falsePressureBg, text_color = falsePressureLatched ? color.red : color.lime, text_size = size.tiny)
    table.cell(statsTable, 2, 15, str.tostring(falsePressureNetRecent, "#.#") + "%", bgcolor = falsePressureBg, text_color = falsePressureNetRecent >= 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(statsTable, 3, 15, str.tostring(falsePressureLossRecent) + "/" + str.tostring(falsePressureClosedRecent) + " loss", bgcolor = falsePressureBg, text_color = falsePressureLossRecent > 0 ? color.white : color.lime, text_size = size.tiny)
    table.cell(statsTable, 4, 15, str.tostring(falsePressureFalseRecent) + "F, PF " + str.tostring(falsePressureProfitFactor, "#.##"), bgcolor = falsePressureBg, text_color = falsePressureProfitFactor >= 1.0 ? color.lime : color.red, text_size = size.tiny)

    color cChopBg = color.rgb(45, 52, 64)
    table.cell(statsTable, 0, 16, "CHOP GUARD", bgcolor = cChopBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 16, chopArmedLabel, bgcolor = cChopBg, text_color = chopArmedColor, text_size = size.tiny)
    table.cell(statsTable, 2, 16, str.tostring(chopConfidenceScore) + "/100 (min " + str.tostring(chopMinConfidence) + ")", bgcolor = cChopBg, text_color = chopConfidenceScore >= chopMinConfidence ? color.lime : color.orange, text_size = size.tiny)
    table.cell(statsTable, 3, 16, "Choppy " + str.tostring(chopFlaggedNetPerTrade, "#.##") + "% vs Normal " + str.tostring(chopNormalNetPerTrade, "#.##") + "%/tr", bgcolor = cChopBg, text_color = chopNetPerTradeEdge >= 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(statsTable, 4, 16, "CI " + str.tostring(chopIndex, "#.#") + " (thr " + str.tostring(chopThreshold, "#.#") + ", n=" + str.tostring(chopEffectiveLength) + ")", bgcolor = cChopBg, text_color = color.white, text_size = size.tiny)

    table.cell(statsTable, 0, 17, "CHOP PF", bgcolor = cChopBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 17, chopVerdict, bgcolor = cChopBg, text_color = chopVerdictColor, text_size = size.tiny)
    table.cell(statsTable, 2, 17, "Choppy PF " + str.tostring(chopFlaggedProfitFactor, "#.##"), bgcolor = cChopBg, text_color = chopFlaggedProfitFactor >= 1.0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(statsTable, 3, 17, "Normal PF " + str.tostring(chopNormalProfitFactor, "#.##"), bgcolor = cChopBg, text_color = chopNormalProfitFactor >= 1.0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(statsTable, 4, 17, "(" + str.tostring(chopFlaggedClosed) + " / " + str.tostring(chopNormalClosed) + " trades)", bgcolor = cChopBg, text_color = color.white, text_size = size.tiny)

    color cDataCovBg = dataCoverageOk ? color.rgb(18, 76, 45) : color.rgb(92, 30, 36)
    table.cell(statsTable, 0, 18, "DATA COVERAGE", bgcolor = cDataCovBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 1, 18, dataCoverageLabel, bgcolor = cDataCovBg, text_color = dataCoverageColor, text_size = size.tiny)
    table.cell(statsTable, 2, 18, "Chart: " + str.tostring(chartHistoryDays, "#") + "d loaded", bgcolor = cDataCovBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 3, 18, "Target: " + str.tostring(statsWindowDays) + "d", bgcolor = cDataCovBg, text_color = color.white, text_size = size.tiny)
    table.cell(statsTable, 4, 18, "Oldest trade: " + str.tostring(oldestClosedTradeDays, "#") + "d ago", bgcolor = cDataCovBg, text_color = color.white, text_size = size.tiny)

    color cCtxHeader = color.rgb(45, 52, 64)
    table.cell(teamContextTable, 0, 0, "Protection", bgcolor = cCtxHeader, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 1, 0, "Score", bgcolor = cCtxHeader, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 2, 0, "Trades", bgcolor = cCtxHeader, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 3, 0, "Avg", bgcolor = cCtxHeader, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 4, 0, "Delta", bgcolor = cCtxHeader, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 0, 1, "Base", bgcolor = pbAutoFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 1, 1, str.tostring(pbAutoFitScore) + "/100", bgcolor = pbAutoFitBg, text_color = pbAutoFitColor, text_size = size.tiny)
    table.cell(teamContextTable, 2, 1, str.tostring(teamClosedStats), bgcolor = pbAutoFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 3, 1, str.tostring(teamAvgProfitStats, "#.##") + "%", bgcolor = pbAutoFitBg, text_color = teamAvgProfitStats >= 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(teamContextTable, 4, 1, pbAutoFitLabel, bgcolor = pbAutoFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 0, 2, "Guard TEAM", bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 1, 2, str.tostring(protectedFitScore) + "/100", bgcolor = protectedFitBg, text_color = protectedFitColor, text_size = size.tiny)
    table.cell(teamContextTable, 2, 2, str.tostring(protectedClosedStats), bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 3, 2, str.tostring(protectedAvgProfitStats, "#.##") + "%", bgcolor = protectedFitBg, text_color = protectedAvgProfitStats >= 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(teamContextTable, 4, 2, protectedFitDeltaText, bgcolor = protectedFitBg, text_color = protectedFitColor, text_size = size.tiny)
    table.cell(teamContextTable, 0, 3, "Guard Used", bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 1, 3, guardDetailText, bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
    table.cell(teamContextTable, 2, 3, "used " + str.tostring(guardUsedTactics), bgcolor = protectedFitBg, text_color = guardUsedTactics > 0 ? color.lime : color.white, text_size = size.tiny)
    table.cell(teamContextTable, 3, 3, "block " + str.tostring(guardBlockedLosses), bgcolor = protectedFitBg, text_color = guardBlockedLosses > 0 ? protectedFitColor : color.white, text_size = size.tiny)
    table.cell(teamContextTable, 4, 3, protectedFitLabel, bgcolor = protectedFitBg, text_color = color.white, text_size = size.tiny)
