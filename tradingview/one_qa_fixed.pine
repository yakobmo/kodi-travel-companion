//@version=6
indicator("אחד", overlay=true, max_labels_count=500)

// === Indicators ===
ema8 = ta.ema(close, 8)
ema21 = ta.ema(close, 21)
rsi = ta.rsi(close, 14)
avgVol = ta.sma(volume, 20)
atr14 = ta.atr(14)
vwapVal = ta.vwap(close)

// === Settings ===
lookbackHigh = input.int(20, "Lookback High")
crashPct = input.float(4.0, "Crash %")
nearHighPct = input.float(3.0, "Near High %")
distFromEma8Pct = input.float(3.0, "Max Distance from EMA8 %", minval=0.1)

// === Webhook Optimization Control ===
webhookGroup = "Webhooks"
enableWebhookAlerts       = input.bool(true, "Enable Webhook Alerts", group=webhookGroup)
alertMainSignals          = input.bool(true, "Alert Main Signals (BUY, BUY+, PB+)", group=webhookGroup)
alertOpeningDriveSignals  = input.bool(true, "FAST Setup alerts", group=webhookGroup)
alertRecoverySignals      = input.bool(true, "Alert Recovery Signals (RALLY)", group=webhookGroup)
alertExitSignals          = input.bool(true, "Alert Exit Signals (EXIT)", group=webhookGroup)
alertFalseBreakoutSignals = input.bool(false, "Alert False Breakout Signals (FALSE)", group=webhookGroup)
executableExitSession     = input.session("0930-1600", "Executable Exit RTH Session", group=webhookGroup)
enableStatsGate           = input.bool(true, "Enable Stats Gate", group=webhookGroup)
statsGateMinWinRatePct    = input.float(40.0, "Stats Gate Min Win Rate %", minval=0.0, maxval=100.0, step=0.5, group=webhookGroup)
statsGateMinSample        = input.int(8, "Stats Gate Min Closed Trades", minval=1, group=webhookGroup)
statsGateMinNetPerTradePct = input.float(2.0, "Stats Gate Min Net Per Trade %", minval=0.0, step=0.1, group=webhookGroup)
statsGateMaxBestTradeSharePct = input.float(40.0, "Stats Gate Max Best Trade Share %", minval=1.0, maxval=100.0, step=1.0, group=webhookGroup)
statsGateMaxEarlyStopRatePct = input.float(50.0, "Stats Gate Max Early Stop %", minval=0.0, maxval=100.0, step=0.5, group=webhookGroup)
quarantineMinNetPerTradePct = input.float(3.0, "Quarantine Min Net/Trade % (BUY+/RALLY/FAST/FSET)", minval=0.0, step=0.1, group=webhookGroup)
statsWindowDays = input.int(180, "Stats Gate Window Days", minval=7, maxval=730, group=webhookGroup)
estRoundTripCostPct = input.float(0.15, "Est. Round-Trip Cost % (subtracted from every trade's P&L)", minval=0.0, step=0.01, group=webhookGroup)

// [Webhook Optimization Control]
minAlertInterval = 15 * 60 * 1000
varip int lastAlertTime = 0
varip string lastAlertFingerprint = ""

// === CHECK POINT Settings ===
enableCheckPoint = input.bool(true, "Enable CHECK POINT")
checkPointBars = input.int(156, "Bars to Check (False Signal)")
checkPointMaxGainPct = input.float(2.0, "Target Gain % for Check")

// === False Signal Pressure Settings ===
// Deterministic and self-contained by design (feeds a live automated trading pipeline): the severity
// score, sample-confidence dampening, and block/clear hysteresis are all derived from the data itself
// with fixed internal thresholds — there is nothing here to manually calibrate.
falsePressureGroup = "False Signal Pressure"
enableFalseSignalPressure = input.bool(true, "Enable False Signal Pressure", group=falsePressureGroup)
falsePressureLookbackDays = input.int(30, "False Pressure Lookback Days", minval=5, maxval=365, group=falsePressureGroup)
falsePressureBlockAuto = input.bool(true, "Block Auto BUY On False Pressure", group=falsePressureGroup)

// === PB+ Strategy Settings ===
pbPlusMinScore = input.float(62.0, "PB+ Min Score")
pbPlusMinBarsBetween = input.int(30, "PB+ Min Bars Between Signals")
pbPlusResetLookback = input.int(30, "PB+ Reset Lookback")
pbPlusResetDropPct = input.float(0.55, "PB+ Reset Drop From High %")
pbPlusRsiResetLevel = input.float(48.0, "PB+ RSI Reset Level")
pbPlusVolumeRatioMin = input.float(1.15, "PB+ Min Volume Ratio")

// === Fast Momentum Settings ===
enableFastMomentum = input.bool(true, "Enable Fast Momentum Buy")
fastMomentumMinBarsBetween = input.int(30, "Fast Momentum Min Bars Between Signals", minval=5)
fastVolumeRatioMin = input.float(1.3, "Fast Momentum Min Volume Ratio", minval=0.5, step=0.1)
fastAtrPctMin = input.float(1.2, "Fast Momentum Min ATR %", minval=0.1, step=0.1)
fastCloseNearHigh = input.float(0.7, "Fast Momentum Close Near High", minval=0.1, maxval=1.0, step=0.05)
fastMaxRun5BarsPct = input.float(8.0, "Fast Momentum Max 5-Bar Run %", minval=1.0, step=0.5)
fastMaxDistanceFromEma8Pct = input.float(5.0, "Fast Momentum Max Distance From EMA8 %", minval=0.5, step=0.5)
fastMinRsi = input.float(52.0, "Fast Momentum Min RSI", minval=40, maxval=75)
enableFastEarly = input.bool(true, "Enable Fast Early Ignition")
fastEarlyMinBarsBetween = input.int(18, "Fast Early Min Bars Between Signals", minval=3)
fastEarlyMinVolumeRatio = input.float(1.15, "Fast Early Min Volume Ratio", minval=0.5, step=0.05)
fastEarlyMinBarGainPct = input.float(0.35, "Fast Early Min Bar Gain %", minval=0.0, step=0.05)
fastEarlyCloseNearHigh = input.float(0.62, "Fast Early Close Near High", minval=0.1, maxval=1.0, step=0.05)
fastEarlyMaxRun5BarsPct = input.float(5.5, "Fast Early Max 5-Bar Run %", minval=1.0, step=0.5)
fastEarlyMaxDistanceFromVwapPct = input.float(3.0, "Fast Early Max Distance From VWAP %", minval=0.1, step=0.1)

// === VWAP Reclaim Settings ===
vwapReclaimGroup = "VWAP Reclaim"
enableVwapReclaim = input.bool(true, "Enable VWAP Reclaim", group=vwapReclaimGroup)
vwapReclaimSession = input.session("0935-1600", "VWAP Reclaim Session", group=vwapReclaimGroup)
vwapReclaimMinBarsBetween = input.int(8, "VWAP Reclaim Min Bars Between Signals", minval=1, group=vwapReclaimGroup)
vwapReclaimMaxSignalsPerDay = input.int(1, "VWAP Reclaim Max Signals Per Day", minval=1, maxval=3, group=vwapReclaimGroup)
vwapReclaimMinVolumeRatio = input.float(1.05, "VWAP Reclaim Min Volume Ratio", minval=0.5, step=0.05, group=vwapReclaimGroup)
vwapReclaimMinClosePosition = input.float(0.58, "VWAP Reclaim Close Position", minval=0.1, maxval=1.0, step=0.05, group=vwapReclaimGroup)
vwapReclaimMaxDistancePct = input.float(3.0, "VWAP Reclaim Max Distance From VWAP %", minval=0.1, step=0.1, group=vwapReclaimGroup)
vwapSlotPullbackBars = input.int(4, "VWAP Slot Pullback Bars", minval=2, maxval=12, group=vwapReclaimGroup)
vwapSlotMaxRun5BarsPct = input.float(5.5, "VWAP Slot Max 5-Bar Run %", minval=0.5, step=0.1, group=vwapReclaimGroup)
vwapSlotMinRelativeStrengthPct = input.float(0.15, "VWAP Slot Min Relative Strength %", minval=-2.0, step=0.05, group=vwapReclaimGroup)
vwapReclaimMinRsi = input.float(50.0, "VWAP Reclaim Min RSI", minval=35, maxval=75, group=vwapReclaimGroup)

// === FAST Setup Expansion Settings ===
openingGroup = "FAST Setup Expansion"
enableOpeningDriveException = input.bool(true, "Enable FAST Setup Expansion", group=openingGroup)
openingSession = input.session("0930-1000", "FAST Setup Context Window", group=openingGroup)
openingTradeSession = input.session("0935-1600", "FAST Setup Trade Window", group=openingGroup)
openingAdaptiveStart = input.bool(true, "FAST Setup Adaptive Start By Timeframe", group=openingGroup)
openingFiveMinDelayFromOpen = input.int(40, "FAST Setup 5m Delay Minutes From Open", minval=30, maxval=90, group=openingGroup)
openingMinVolumeRatio = input.float(1.10, "FAST Setup Min Volume Ratio", minval=0.5, step=0.05, group=openingGroup)
openingMinBarGainPct = input.float(0.25, "FAST Setup Min Bar Gain %", minval=0.0, step=0.05, group=openingGroup)
openingWashLookbackBars = input.int(4, "FAST Setup Hold Lookback Bars", minval=1, maxval=12, group=openingGroup)
openingMaxRun5BarsPct = input.float(4.8, "FAST Setup Max 5-Bar Run %", minval=1.0, step=0.5, group=openingGroup)
openingCloseNearHigh = input.float(0.62, "FAST Setup Close Position", minval=0.1, maxval=1.0, step=0.05, group=openingGroup)
openingMaxDistanceFromVwapPct = input.float(3.0, "FAST Setup Max Distance From VWAP %", minval=0.1, step=0.1, group=openingGroup)
openingMinRsi = input.float(52.0, "FAST Setup Min RSI", minval=35, maxval=80, group=openingGroup)
openingMinBarsBetween = input.int(8, "FAST Setup Min Bars Between Signals", minval=1, group=openingGroup)
openingMaxSignalsPerDay = input.int(1, "FAST Setup Max Signals Per Day", minval=1, maxval=5, group=openingGroup)
openingStatsTimeoutBars = input.int(24, "FAST Setup Stats Timeout Bars", minval=1, group=openingGroup)

// === Early Rebound Buy Settings ===
reboundGroup = "Early Rebound Buy"
enableEarlyReboundBuy = input.bool(true, "Enable Early Rebound Buy", group=reboundGroup)
reboundSession = input.session("0940-1015", "Early Rebound Window", group=reboundGroup)
reboundMinVolumeRatio = input.float(1.2, "Rebound Min Volume Ratio", minval=0.5, step=0.1, group=reboundGroup)
reboundMinBarGainPct = input.float(0.35, "Rebound Min Bar Gain %", minval=0.0, step=0.05, group=reboundGroup)
reboundCloseNearHigh = input.float(0.55, "Rebound Close Near High", minval=0.1, maxval=1.0, step=0.05, group=reboundGroup)
reboundMaxDistanceFromVwapPct = input.float(4.0, "Rebound Max Distance From VWAP %", minval=0.1, step=0.1, group=reboundGroup)
reboundMinRsi = input.float(52.0, "Rebound Min RSI", minval=40, maxval=80, group=reboundGroup)
reboundMinBarsBetween = input.int(3, "Rebound Min Bars Between Signals", minval=1, group=reboundGroup)
reboundMaxSignalsPerDay = input.int(3, "Rebound Max Signals Per Day", minval=1, maxval=5, group=reboundGroup)

// === 10m Early Turn Buy Settings ===
turnGroup = "10m Early Turn Buy"
enableTenMinTurnBuy = input.bool(true, "Enable 10m Early Turn Buy", group=turnGroup)
turnSession = input.session("0935-1600", "10m Turn Session", group=turnGroup)
turnMinVolumeRatio = input.float(1.25, "10m Turn Min Volume Ratio", minval=0.5, step=0.1, group=turnGroup)
turnMinBarGainPct = input.float(0.25, "10m Turn Min Bar Gain %", minval=0.0, step=0.05, group=turnGroup)
turnCloseNearHigh = input.float(0.60, "10m Turn Close Near High", minval=0.1, maxval=1.0, step=0.05, group=turnGroup)
turnMinRsi = input.float(50.0, "10m Turn Min RSI", minval=40, maxval=75, group=turnGroup)
turnMinPullbackAtr = input.float(0.75, "10m Turn Min Recent Pullback ATR", minval=0.1, step=0.05, group=turnGroup)
turnMaxRun5BarsPct = input.float(6.0, "10m Turn Max 5-Bar Run %", minval=1.0, step=0.5, group=turnGroup)
turnMaxDistanceFromEma8Pct = input.float(2.5, "10m Turn Max Distance From EMA8 %", minval=0.1, step=0.1, group=turnGroup)
turnMaxDistanceFromVwapPct = input.float(4.0, "10m Turn Max Distance From VWAP %", minval=0.1, step=0.1, group=turnGroup)
turnMinBarsBetween = input.int(6, "10m Turn Min Bars Between Signals", minval=1, group=turnGroup)
// === Runner & Trail Settings ===
runnerTriggerPct = input.float(5.0, "Runner Trigger %")
early_atr_mult   = input.float(1.8, "Early Protection ATR Multiplier", minval=0.5, step=0.1)
pb_atr_mult      = input.float(3.6, "[UNUSED — legacy, kept only to avoid disturbing saved settings] Runner ATR Exit Multiplier (k)", minval=0.5, step=0.1)
trailStopPct     = input.float(6.0, "Runner Trailing Stop % (from peak)", minval=0.5, step=0.5)

// === Rally Recovery Settings ===
recoveryGroup = "Rally Recovery PB X"
enableRallyRecovery = input.bool(true, "Enable Rally Recovery PB X", group=recoveryGroup)
rallyRecoveryMinutes = input.int(90, "Rally Recovery Window (Minutes)", minval=5, maxval=600, group=recoveryGroup)
recoveryMinRsi = input.float(55.0, "RSI Min Level", minval=40, maxval=70, group=recoveryGroup)

// === BUY+ "3 Bar Play" Settings (isolated — affects BUY+ only; replaces retired Absorption Breakout) ===
tbpBar1ClosePosMin = input.float(0.8, "BUY+ Bar1 Close Position (Top %)", minval=0.5, maxval=1.0, step=0.05)
tbpMinBarsBetween = input.int(10, "BUY+ Min Bars Between Signals", minval=1)
tbpMinRsi = input.float(45.0, "BUY+ Min RSI", minval=30, maxval=70)
tbpRequireDailyBullContext = input.bool(true, "BUY+ Require Stock Daily Uptrend")

// === BUY Logic ===
recentHigh = ta.highest(high, lookbackHigh)
dropFromHigh = ((recentHigh - close) / recentHigh) * 100
nearHigh = dropFromHigh <= nearHighPct
crash = dropFromHigh >= crashPct and rsi < 45
candleRange = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
lowerWick = (math.min(open, close) - low) > candleRange * 0.4
smallBody = body < candleRange * 0.3
stabilizing = lowerWick or smallBody
strongGreen = close > open and body > candleRange * 0.5
breakPrevHigh = close > high[1]
rsiUp = rsi > rsi[1]

isNotTooFar = ((close - ema8) / ema8) * 100 <= distFromEma8Pct

buy = crash[1] and stabilizing[1] and strongGreen and breakPrevHigh and rsiUp and not nearHigh and isNotTooFar

// --- BUY+ "3 Bar Play" computation (self-contained, no state outside this block) ---
// Bar1 = two bars back (the strong directional bar), Bar2 = previous bar (inside bar), current bar = breakout.
float tbpBar1High = high[2]
float tbpBar1Low = low[2]
float tbpBar1Range = math.max(tbpBar1High - tbpBar1Low, syminfo.mintick)
float tbpBar1ClosePos = (close[2] - tbpBar1Low) / tbpBar1Range
bool tbpBar1Strong = close[2] > open[2] and tbpBar1ClosePos >= tbpBar1ClosePosMin and volume[2] > avgVol[2]

bool tbpBar2Inside = high[1] < tbpBar1High and low[1] > tbpBar1Low

bool tbpBreakout = close > high[1] and close > open

var int lastTbpBar = na
int tbpBarsFromLast = na(lastTbpBar) ? 999999 : bar_index - lastTbpBar
bool tbpSpacingOk = tbpBarsFromLast >= tbpMinBarsBetween

float tbpDailyClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float tbpDailyEma21 = request.security(syminfo.tickerid, "D", ta.ema(close, 21)[1], barmerge.gaps_off, barmerge.lookahead_off)
bool tbpDailyOk = not tbpRequireDailyBullContext or (tbpDailyClose > tbpDailyEma21)

buyPlus = tbpBar1Strong and tbpBar2Inside and tbpBreakout and tbpSpacingOk and rsi >= tbpMinRsi and tbpDailyOk

if buyPlus
    lastTbpBar := bar_index

buyClean = buy and not buyPlus

// === Daily Context ===
dailyCloseLong = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
dailyEma21Long = request.security(syminfo.tickerid, "D", ta.ema(close, 21)[1], barmerge.gaps_off, barmerge.lookahead_off)
dailyBullContext = dailyCloseLong > dailyEma21Long
volumeRatio = avgVol > 0 ? volume / avgVol : 0.0

qqqClose = request.security("NASDAQ:QQQ", timeframe.period, close[1], barmerge.gaps_off, barmerge.lookahead_off)
qqqEma21 = request.security("NASDAQ:QQQ", timeframe.period, ta.ema(close, 21)[1], barmerge.gaps_off, barmerge.lookahead_off)
qqqDailyClose = request.security("NASDAQ:QQQ", "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
qqqDailyEma21 = request.security("NASDAQ:QQQ", "D", ta.ema(close, 21)[1], barmerge.gaps_off, barmerge.lookahead_off)

qqqTrendUp = qqqClose > qqqEma21
qqqDailyTrendUp = qqqDailyClose > qqqDailyEma21

// [Relative Strength]
qqqClose5 = request.security("NASDAQ:QQQ", timeframe.period, close[5], barmerge.gaps_off, barmerge.lookahead_off)
qqqChange = qqqClose5 > 0 ? (qqqClose - qqqClose5) / qqqClose5 : 0.0
stockChange = close[5] > 0 ? (close - close[5]) / close[5] : 0.0
isStrongerThanMarket = stockChange > qqqChange

// === PB+ Base Logic ===
trendUp = close > ema8 and ema8 > ema8[1]
pullback = low <= ema8
reclaim = close > open and close > high[1]
pbPlusBase = trendUp and pullback and reclaim and volumeRatio >= pbPlusVolumeRatioMin and rsi > 50 and isNotTooFar

// === PB+ Score ===
float pbScoreDailyContext = dailyBullContext ? 25 : 0
float pbScoreVolume = volumeRatio >= pbPlusVolumeRatioMin ? 20 : 0
float pbScoreRsi = rsi > 50 ? 15 : 0
float pbScoreBreakPrevHigh = close > high[1] ? 15 : 0
float pbScoreEma8Slope = ema8 > ema8[1] ? 10 : 0
float pbScorePullback = pullback ? 10 : 0
float pbScoreReclaim = reclaim ? 5 : 0
float finalScore = 0.0
finalScore += pbScoreDailyContext
finalScore += pbScoreVolume
finalScore += pbScoreRsi
finalScore += pbScoreBreakPrevHigh
finalScore += pbScoreEma8Slope
finalScore += pbScorePullback
finalScore += pbScoreReclaim

// === RESET STATE MACHINE ===
var int lastPbPlusBar = na
var int lastFastMomentumBar = na
var float pbHighSinceLast = na
var bool pbHadTrueReset = true
if na(pbHighSinceLast)
    pbHighSinceLast := high
else
    pbHighSinceLast := math.max(pbHighSinceLast, high)

barsFromLastPbPlus = na(lastPbPlusBar) ? 999999 : bar_index - lastPbPlusBar
dropFromPbHigh = pbHighSinceLast > 0 ? ((pbHighSinceLast - low) / pbHighSinceLast) * 100 : 0.0
lowestRsiReset = ta.lowest(rsi, pbPlusResetLookback)
pbTrueReset = (dropFromPbHigh >= pbPlusResetDropPct) or (close < ema8) or (lowestRsiReset <= pbPlusRsiResetLevel)

if pbTrueReset and barsFromLastPbPlus >= 3
    pbHadTrueReset := true
pbSpacingOk = barsFromLastPbPlus >= pbPlusMinBarsBetween
showPbPlus = pbPlusBase and dailyBullContext and finalScore >= pbPlusMinScore and pbSpacingOk and pbHadTrueReset and not buy

earningsTime = earnings.future_time
daysToEarnings = not na(earningsTime) ? (earningsTime - time) / 86400000 : 999

// === COST OPTIMIZATION (FILTERS) ===
isMarketRiskOff      = not qqqTrendUp
isEarningsVeto       = (daysToEarnings <= 2)
gapPct               = ((open - close[1]) / close[1]) * 100
isGapRisk            = gapPct > 2.0
isAtrSpikeRisk       = (high - low) > (2.0 * atr14)
isHighExecutionRisk  = isGapRisk or isAtrSpikeRisk

enableStockDailyWeakFilter = input.bool(false, "Enable Stock Daily Downtrend Filter (blocks entries when the stock itself is below its daily EMA21)")
isStockDailyWeak     = enableStockDailyWeakFilter and not dailyBullContext

// === CHOP PROTECTION (Choppiness Index) — off by default, additive only ===
chopGroup = "Chop Protection"
enableChopFilter = input.bool(true, "Enable Chop Protection (auto-adaptive: only blocks entries when this symbol's own history shows it helps)", group=chopGroup)
chopUseAdaptiveLength = input.bool(true, "Scale Chop Length to Real Time (minutes) instead of fixed bar count", group=chopGroup)
chopTargetMinutes = input.int(210, "Chop Lookback Target (minutes) — same real-world window across timeframes", minval=30, maxval=600, step=15, group=chopGroup)
chopLength = input.int(14, "Chop Index Length (bars) — used only if adaptive scaling above is off", minval=5, maxval=50, group=chopGroup)
chopThreshold = input.float(61.8, "Chop Index Block Threshold (0-100, higher = choppier)", minval=50.0, maxval=100.0, step=0.1, group=chopGroup)
chopTfMinutesRaw = timeframe.in_seconds(timeframe.period) / 60.0
chopTfMinutes = chopTfMinutesRaw > 0 ? chopTfMinutesRaw : 1.0
chopEffectiveLength = chopUseAdaptiveLength ? int(math.max(5, math.round(chopTargetMinutes / chopTfMinutes))) : chopLength
chopTrueRange = ta.tr(true)
chopSumTrueRange = math.sum(chopTrueRange, chopEffectiveLength)
chopRangeHigh = ta.highest(high, chopEffectiveLength)
chopRangeLow = ta.lowest(low, chopEffectiveLength)
chopRange = chopRangeHigh - chopRangeLow
chopIndex = chopRange > 0 ? 100 * math.log10(chopSumTrueRange / chopRange) / math.log10(chopEffectiveLength) : 0.0
chopThresholdCrossed = chopIndex >= chopThreshold
chopIsChoppyAtEntryStats = chopThresholdCrossed

isFilterTriggered    = isMarketRiskOff or isEarningsVeto or isHighExecutionRisk or isStockDailyWeak
string teamMarketContextNow = isMarketRiskOff ? "WEAK" : qqqDailyTrendUp and qqqTrendUp ? "SUPPORT" : "NEUTRAL"

pbPlusBeforeFilter = showPbPlus
pbPlusBlockedByFilter = pbPlusBeforeFilter and isFilterTriggered

if isFilterTriggered
    buyClean    := false
    buyPlus     := false
    showPbPlus  := false

// === RALLY RECOVERY LOGIC (TECH OPTIMIZED v6.8) ===
var int lastPbBlockBar = na
var int lastPbBlockTime = na
var float blockedPbHighPrice = na

pbPlusBlockedByTransientFilter = pbPlusBeforeFilter and isHighExecutionRisk

if pbPlusBlockedByTransientFilter
    lastPbBlockBar := bar_index
    lastPbBlockTime := time
    blockedPbHighPrice := high

if close < ema21 or rsi < 45
    lastPbBlockBar := na
    lastPbBlockTime := na
    blockedPbHighPrice := na

minutesSincePbBlock = na(lastPbBlockTime) ? 999999 : (time - lastPbBlockTime) / 60000
checkRecovery = enableRallyRecovery and not na(lastPbBlockBar) and bar_index > lastPbBlockBar and minutesSincePbBlock <= rallyRecoveryMinutes

bool pbRecoveryBuy = false

// [Rally Recovery Logic]
if checkRecovery and close > ema8 and strongGreen and close > blockedPbHighPrice and rsi >= recoveryMinRsi and isStrongerThanMarket and volumeRatio >= 0.9 and not isFilterTriggered
    pbRecoveryBuy := true
    lastPbBlockBar := na
    lastPbBlockTime := na
    blockedPbHighPrice := na

if showPbPlus or pbRecoveryBuy
    lastPbPlusBar := bar_index
    pbHighSinceLast := high
    pbHadTrueReset := false

// === FAST MOMENTUM BUY LOGIC ===
fastAtrPct = close > 0 ? (atr14 / close) * 100 : 0.0
fastDistanceFromEma8Pct = ema8 > 0 ? math.abs(close - ema8) / ema8 * 100 : 0.0
fastClosePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
fastRun5BarsPct = close[5] > 0 ? ((close - close[5]) / close[5]) * 100 : 0.0
fastBarGainPct = open > 0 ? ((close - open) / open) * 100 : 0.0
fastBarsFromLast = na(lastFastMomentumBar) ? 999999 : bar_index - lastFastMomentumBar
fastSpacingOk = fastBarsFromLast >= fastMomentumMinBarsBetween
fastMomentumBase = close > ema8 and ema8 > ema8[1] and close > vwapVal and strongGreen and fastClosePosition >= fastCloseNearHigh and volumeRatio >= fastVolumeRatioMin and fastAtrPct >= fastAtrPctMin and rsi >= fastMinRsi and isStrongerThanMarket and fastRun5BarsPct <= fastMaxRun5BarsPct and fastDistanceFromEma8Pct <= fastMaxDistanceFromEma8Pct
showFastMomentum = enableFastMomentum and fastMomentumBase and fastSpacingOk and not isFilterTriggered and not buy and not showPbPlus and not pbRecoveryBuy

if showFastMomentum
    lastFastMomentumBar := bar_index

// === FAST EARLY IGNITION LOGIC ===
var int lastFastEarlyBar = na
fastEarlyBarsFromLast = na(lastFastEarlyBar) ? 999999 : bar_index - lastFastEarlyBar
fastEarlySpacingOk = fastEarlyBarsFromLast >= fastEarlyMinBarsBetween
fastEarlyDistanceFromVwapPct = vwapVal > 0 ? math.abs(close - vwapVal) / vwapVal * 100 : 0.0
fastEarlyIgnition = close > open and close > ema8 and close > vwapVal and ema8 >= ema8[1] and close > high[1] and fastClosePosition >= fastEarlyCloseNearHigh and fastBarGainPct >= fastEarlyMinBarGainPct and volumeRatio >= fastEarlyMinVolumeRatio and rsi >= 50 and isStrongerThanMarket
showFastEarly = enableFastEarly and fastEarlyIgnition and fastEarlySpacingOk and fastRun5BarsPct <= fastEarlyMaxRun5BarsPct and fastEarlyDistanceFromVwapPct <= fastEarlyMaxDistanceFromVwapPct and not isFilterTriggered and not buy and not showPbPlus and not pbRecoveryBuy and not showFastMomentum

if showFastEarly
    lastFastEarlyBar := bar_index

// === 10m EARLY TURN BUY LOGIC ===
var int lastTenMinTurnBar = na
inTenMinTurnWindow = not na(time(timeframe.period, turnSession))
turnClosePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
turnBarGainPct = open > 0 ? ((close - open) / open) * 100 : 0.0
turnRun5BarsPct = close[5] > 0 ? ((close - close[5]) / close[5]) * 100 : 0.0
turnRecentPullbackAtr = atr14 > 0 ? (ta.highest(high, 6)[1] - ta.lowest(low, 6)) / atr14 : 0.0
turnDistanceFromEma8Pct = ema8 > 0 ? math.abs(close - ema8) / ema8 * 100 : 0.0
turnDistanceFromVwapPct = vwapVal > 0 ? math.abs(close - vwapVal) / vwapVal * 100 : 0.0
turnBarsFromLast = na(lastTenMinTurnBar) ? 999999 : bar_index - lastTenMinTurnBar
turnSpacingOk = turnBarsFromLast >= turnMinBarsBetween
turnRecoveredFromRed = close > open and close[1] < open[1]
turnStructureOk = close > ema8 and close > vwapVal and close > high[1] and ema8 >= ema8[1]
turnNotTooExtended = turnRun5BarsPct <= turnMaxRun5BarsPct and turnDistanceFromEma8Pct <= turnMaxDistanceFromEma8Pct and turnDistanceFromVwapPct <= turnMaxDistanceFromVwapPct
turnBase = enableTenMinTurnBuy and inTenMinTurnWindow and turnSpacingOk and turnStructureOk and turnRecoveredFromRed and turnBarGainPct >= turnMinBarGainPct and turnClosePosition >= turnCloseNearHigh and volumeRatio >= turnMinVolumeRatio and rsi >= turnMinRsi and turnRecentPullbackAtr >= turnMinPullbackAtr and turnNotTooExtended and isStrongerThanMarket
showTenMinTurn = turnBase and not isFilterTriggered

if showTenMinTurn
    lastTenMinTurnBar := bar_index

// === FAST SETUP EXPANSION LOGIC ===
var int lastOpeningDriveBar = na
var int openingDriveSignalsToday = 0
var bool openingDriveActivatedToday = false
var float openingRangeHigh = na
var float openingRangeLow = na
var int vwapReclaimSignalsToday = 0
var int lastEarlyReboundBar = na
var int earlyReboundSignalsToday = 0
newTradingDay = ta.change(time("D")) != 0
if newTradingDay
    openingDriveSignalsToday := 0
    openingDriveActivatedToday := false
    openingRangeHigh := na
    openingRangeLow := na
    vwapReclaimSignalsToday := 0
    earlyReboundSignalsToday := 0

inOpeningDriveWindow = not na(time(timeframe.period, openingSession))
inOpeningTradeWindow = not na(time(timeframe.period, openingTradeSession))
inEarlyReboundWindow = not na(time(timeframe.period, reboundSession))
inExecutableExitSession = not na(time(timeframe.period, executableExitSession))
openingTfMinutes = timeframe.in_seconds(timeframe.period) / 60.0
openingMarketOpenMinute = 9 * 60 + 30
openingBarMinute = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
openingStartDelayMinutes = openingAdaptiveStart and openingTfMinutes <= 5 ? openingFiveMinDelayFromOpen : 30
openingAdaptiveStartOk = openingBarMinute >= openingMarketOpenMinute + openingStartDelayMinutes
if inOpeningDriveWindow
    openingRangeHigh := na(openingRangeHigh) ? high : math.max(openingRangeHigh, high)
    openingRangeLow := na(openingRangeLow) ? low : math.min(openingRangeLow, low)

openingBarsFromLast = na(lastOpeningDriveBar) ? 999999 : bar_index - lastOpeningDriveBar
openingSpacingOk = openingBarsFromLast >= openingMinBarsBetween
earlyReboundBarsFromLast = na(lastEarlyReboundBar) ? 999999 : bar_index - lastEarlyReboundBar
earlyReboundSpacingOk = earlyReboundBarsFromLast >= reboundMinBarsBetween
openingBarGainPct = open > 0 ? ((close - open) / open) * 100 : 0.0
openingClosePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
openingDistanceFromVwapPct = vwapVal > 0 ? math.abs(close - vwapVal) / vwapVal * 100 : 0.0
openingRun5BarsPct = close[5] > 0 ? ((close - close[5]) / close[5]) * 100 : 0.0
openingSetupRelativeStrengthPct = (stockChange - qqqChange) * 100
openingSetupTrendOk = close > ema8 and close > vwapVal and ema8 >= ema21 and ema8 >= ema8[1]
openingSetupRecentPullback = ta.lowest(low - ema8, openingWashLookbackBars) <= 0 or ta.lowest(low - vwapVal, openingWashLookbackBars) <= 0
openingSetupReclaimOk = close > open and close > high[1] and close > ema8 and close > vwapVal
openingSetupBodyOk = body >= candleRange * 0.40
openingSetupNotChase = openingRun5BarsPct <= openingMaxRun5BarsPct and openingDistanceFromVwapPct <= openingMaxDistanceFromVwapPct
earlyReboundDistanceFromVwapPct = vwapVal > 0 ? ((close - vwapVal) / vwapVal) * 100 : 0.0
earlyReboundBarGainPct = open > 0 ? ((close - open) / open) * 100 : 0.0
earlyReboundClosePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
openingMoveOk = openingSetupTrendOk and openingSetupRecentPullback and openingSetupReclaimOk and openingSetupBodyOk and openingSetupNotChase and openingBarGainPct >= openingMinBarGainPct
openingVwapOk = openingDistanceFromVwapPct <= openingMaxDistanceFromVwapPct
openingMarketOk = not isFilterTriggered and (qqqTrendUp or openingSetupRelativeStrengthPct >= 0.25)
openingDriveCandidate = enableOpeningDriveException and inOpeningTradeWindow and openingAdaptiveStartOk and openingDriveSignalsToday < openingMaxSignalsPerDay and openingSpacingOk and openingMoveOk and openingVwapOk and close > open and openingClosePosition >= openingCloseNearHigh and volumeRatio >= openingMinVolumeRatio and rsi >= openingMinRsi and openingMarketOk
showOpeningDriveException = openingDriveCandidate and not buy and not showPbPlus and not pbRecoveryBuy and not showFastMomentum and not showFastEarly
earlyReboundMarketOk = qqqTrendUp or isStrongerThanMarket
earlyReboundBase = enableEarlyReboundBuy and inEarlyReboundWindow and earlyReboundSignalsToday < reboundMaxSignalsPerDay and earlyReboundSpacingOk and close > vwapVal and close > ema8 and ema8 > ema8[1] and earlyReboundDistanceFromVwapPct <= reboundMaxDistanceFromVwapPct and earlyReboundBarGainPct >= reboundMinBarGainPct and earlyReboundClosePosition >= reboundCloseNearHigh and volumeRatio >= reboundMinVolumeRatio and rsi >= reboundMinRsi and earlyReboundMarketOk
showEarlyRebound = earlyReboundBase and not isFilterTriggered and not openingDriveActivatedToday and not buy and not showPbPlus and not pbRecoveryBuy and not showFastMomentum and not showOpeningDriveException

// === VWAP RECLAIM LOGIC ===
var int lastVwapReclaimBar = na
inVwapReclaimWindow = not na(time(timeframe.period, vwapReclaimSession))
vwapReclaimBarsFromLast = na(lastVwapReclaimBar) ? 999999 : bar_index - lastVwapReclaimBar
vwapReclaimSpacingOk = vwapReclaimBarsFromLast >= vwapReclaimMinBarsBetween
vwapReclaimClosePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
vwapReclaimDistancePct = vwapVal > 0 ? math.abs(close - vwapVal) / vwapVal * 100 : 0.0
vwapSlotRun5BarsPct = close[5] > 0 ? ((close - close[5]) / close[5]) * 100 : 0.0
vwapSlotRelativeStrengthPct = (stockChange - qqqChange) * 100
vwapSlotTrendOk = close > ema8 and close > vwapVal and ema8 >= ema21 and ema8 >= ema8[1]
vwapSlotPullbackOk = ta.lowest(low - ema8, vwapSlotPullbackBars) <= 0 or ta.lowest(low - vwapVal, vwapSlotPullbackBars) <= 0
vwapSlotReclaimOk = close > open and close > high[1] and vwapReclaimClosePosition >= vwapReclaimMinClosePosition
vwapSlotNotChase = vwapReclaimDistancePct <= vwapReclaimMaxDistancePct and vwapSlotRun5BarsPct <= vwapSlotMaxRun5BarsPct
vwapReclaimMarketOk = qqqTrendUp or vwapSlotRelativeStrengthPct >= vwapSlotMinRelativeStrengthPct
vwapReclaimDailyCapOk = vwapReclaimSignalsToday < vwapReclaimMaxSignalsPerDay
vwapReclaimBase = enableVwapReclaim and inVwapReclaimWindow and vwapReclaimDailyCapOk and vwapReclaimSpacingOk and vwapSlotTrendOk and vwapSlotPullbackOk and vwapSlotReclaimOk and vwapSlotNotChase and volumeRatio >= vwapReclaimMinVolumeRatio and rsi >= vwapReclaimMinRsi and vwapReclaimMarketOk
showVwapReclaim = vwapReclaimBase and not isFilterTriggered and not buy and not showPbPlus and not pbRecoveryBuy and not showFastMomentum and not showFastEarly and not showTenMinTurn and not showEarlyRebound

if showVwapReclaim
    lastVwapReclaimBar := bar_index
    vwapReclaimSignalsToday += 1

if showOpeningDriveException
    lastOpeningDriveBar := bar_index
    openingDriveSignalsToday += 1
if showEarlyRebound
    lastEarlyReboundBar := bar_index
    earlyReboundSignalsToday += 1
// === STATS ENGINE ===
isAnySignal = buyClean or buyPlus or showPbPlus or pbRecoveryBuy or showFastMomentum or showFastEarly or showTenMinTurn or showEarlyRebound or showVwapReclaim or showOpeningDriveException
isExecutableStatsSignal = barstate.isconfirmed and (buyClean or buyPlus or showPbPlus or pbRecoveryBuy or showFastMomentum or showFastEarly or showTenMinTurn or showEarlyRebound or showVwapReclaim)
openingExecutableStatsSignal = barstate.isconfirmed and showOpeningDriveException

// === ATR EXIT STATS ===
var int closedTradesATR = 0
var int winsATR = 0
var float profitATR = 0.0

var float[] tEntryPrices = array.new_float()
var float[] tMaxHighs = array.new_float()
var int[] tEntryBars = array.new_int()
var string[] tEntryTypesStats = array.new_string()
var bool[] tActiveATR = array.new_bool()
var bool[] tRunnerATR = array.new_bool()
var bool[] tChopAtEntry = array.new_bool()
var bool[] tRedDuringHold = array.new_bool()
var int buyEntryStats = 0
var int buyPlusEntryStats = 0
var int pbPlusEntryStats = 0
var int rallyEntryStats = 0
var int fastEntryStats = 0
var int fastEarlyEntryStats = 0
var int turnEntryStats = 0
var int reboundEntryStats = 0
var int vwapReclaimEntryStats = 0
var int buyClosedStats = 0
var int buyPlusClosedStats = 0
var int pbPlusClosedStats = 0
var int rallyClosedStats = 0
var int fastClosedStats = 0
var int fastEarlyClosedStats = 0
var int turnClosedStats = 0
var int reboundClosedStats = 0
var int vwapReclaimClosedStats = 0
var int buyWinsStats = 0
var int buyPlusWinsStats = 0
var int pbPlusWinsStats = 0
var int rallyWinsStats = 0
var int fastWinsStats = 0
var int fastEarlyWinsStats = 0
var int turnWinsStats = 0
var int reboundWinsStats = 0
var int vwapReclaimWinsStats = 0
var float buyProfitStats = 0.0
var float buyPlusProfitStats = 0.0
var float pbPlusProfitStats = 0.0
var float rallyProfitStats = 0.0
var float fastProfitStats = 0.0
var float fastEarlyProfitStats = 0.0
var float turnProfitStats = 0.0
var float reboundProfitStats = 0.0
var float vwapReclaimProfitStats = 0.0
var float buyBestTradeStats = 0.0
var float buyPlusBestTradeStats = 0.0
var float pbPlusBestTradeStats = 0.0
var float rallyBestTradeStats = 0.0
var float fastBestTradeStats = 0.0
var float fastEarlyBestTradeStats = 0.0
var float turnBestTradeStats = 0.0
var float reboundBestTradeStats = 0.0
var float vwapReclaimBestTradeStats = 0.0
var int buySurvivedStats = 0
var int buyPlusSurvivedStats = 0
var int pbPlusSurvivedStats = 0
var int rallySurvivedStats = 0
var int fastSurvivedStats = 0
var int fastEarlySurvivedStats = 0
var int turnSurvivedStats = 0
var int reboundSurvivedStats = 0
var int vwapReclaimSurvivedStats = 0
var float buySurvivedProfitStats = 0.0
var float buyPlusSurvivedProfitStats = 0.0
var float pbPlusSurvivedProfitStats = 0.0
var float rallySurvivedProfitStats = 0.0
var float fastSurvivedProfitStats = 0.0
var float fastEarlySurvivedProfitStats = 0.0
var float turnSurvivedProfitStats = 0.0
var float reboundSurvivedProfitStats = 0.0
var float vwapReclaimSurvivedProfitStats = 0.0
var int buyEarlyStopStats = 0
var int buyPlusEarlyStopStats = 0
var int pbPlusEarlyStopStats = 0
var int rallyEarlyStopStats = 0
var int fastEarlyStopStats = 0
var int fastEarlyEarlyStopStats = 0
var int turnEarlyStopStats = 0
var int reboundEarlyStopStats = 0
var int vwapReclaimEarlyStopStats = 0
// FAST Setup stats are intentionally separate from the regular PB stats.
var int openingClosedTrades = 0
var int openingWins = 0
var float openingProfit = 0.0
var float openingBestTradeStats = 0.0
var int openingEntryStats = 0
var int openingEarlyStopStats = 0
var int openingSurvivedStats = 0
var float openingSurvivedProfitStats = 0.0
var float[] openingEntryPrices = array.new_float()
var float[] openingMaxHighs = array.new_float()
var int[] openingEntryBars = array.new_int()
var bool[] openingActiveATR = array.new_bool()
var bool[] openingRunnerATR = array.new_bool()
var bool[] openingChopAtEntry = array.new_bool()
var bool[] openingRedDuringHold = array.new_bool()
var int selectedEntryStatsAuto = 0
var int selectedClosedStatsAuto = 0
var int selectedWinsStatsAuto = 0
var float selectedProfitStatsAuto = 0.0
var int selectedEarlyStopStatsAuto = 0
var int selectedSurvivedStatsAuto = 0
var float selectedSurvivedProfitStatsAuto = 0.0
var int[] selectedWindowEntryTimes = array.new_int()
var int[] selectedWindowExitTimes = array.new_int()
var float[] selectedWindowProfitPcts = array.new_float()
var bool[] selectedWindowEarlyStopFlags = array.new_bool()
// Tracks only the selected operational route, not every raw strategy signal.
var string[] entryMarketContexts = array.new_string()
var int teamContextSupportClosed = 0
var int teamContextSupportWins = 0
var float teamContextSupportProfit = 0.0
var int teamContextSupportStops = 0
var int teamContextNeutralClosed = 0
var int teamContextNeutralWins = 0
var float teamContextNeutralProfit = 0.0
var int teamContextNeutralStops = 0
var int teamContextWeakClosed = 0
var int teamContextWeakWins = 0
var float teamContextWeakProfit = 0.0
var int teamContextWeakStops = 0
var int[] statsWindowTimes = array.new_int()
var float[] statsWindowProfitPcts = array.new_float()
var bool[] statsWindowEarlyStopFlags = array.new_bool()
var string[] statsWindowTypes = array.new_string()
var bool[] statsWindowRedMarketFlags = array.new_bool()
var bool[] statsWindowChopFlags = array.new_bool()
var int[] statsWindowEntryTimes = array.new_int()
var string[] statsWindowEntryTypes = array.new_string()
var int[] falsePressureTimes = array.new_int()
var float[] falsePressureProfitPcts = array.new_float()
var bool[] falsePressureFalseFlags = array.new_bool()
var bool[] falsePressureRedMarketFlags = array.new_bool()
var bool[] falsePressureEarlyStopFlags = array.new_bool()
var string[] falsePressureTypes = array.new_string()

if isExecutableStatsSignal
    if buyClean
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "BUY")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        buyEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "BUY")
    if buyPlus
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "BUY_PLUS")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        buyPlusEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "BUY_PLUS")
    if showPbPlus
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "PB_PLUS")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        pbPlusEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "PB_PLUS")
    if pbRecoveryBuy
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "RALLY_BUY")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        rallyEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "RALLY_BUY")
    if showFastMomentum
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "FAST_MOMENTUM_BUY")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        fastEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "FAST_MOMENTUM_BUY")
    if showFastEarly
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "FAST_EARLY_BUY")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        fastEarlyEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "FAST_EARLY_BUY")
    if showTenMinTurn
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "TEN_MIN_TURN_BUY")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        turnEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "TEN_MIN_TURN_BUY")
    if showEarlyRebound
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "EARLY_REBOUND_BUY")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        reboundEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "EARLY_REBOUND_BUY")
    if showVwapReclaim
        array.push(tEntryPrices, close)
        array.push(tMaxHighs, high)
        array.push(tEntryBars, bar_index)
        array.push(tEntryTypesStats, "VWAP_RECLAIM_BUY")
        array.push(tActiveATR, true)
        array.push(tRunnerATR, false)
        array.push(tChopAtEntry, chopIsChoppyAtEntryStats)
        array.push(tRedDuringHold, isMarketRiskOff)
        vwapReclaimEntryStats += 1
        array.push(statsWindowEntryTimes, time)
        array.push(statsWindowEntryTypes, "VWAP_RECLAIM_BUY")

if array.size(tEntryPrices) > 0
    for i = array.size(tEntryPrices) - 1 to 0
        float ent = array.get(tEntryPrices, i)
        float prevMaxH = array.get(tMaxHighs, i)
        int bIdx = array.get(tEntryBars, i)
        string trackedEntryType = array.get(tEntryTypesStats, i)
        bool trackedChopAtEntry = array.get(tChopAtEntry, i)
        bool trackedRedDuringHold = array.get(tRedDuringHold, i) or isMarketRiskOff
        array.set(tRedDuringHold, i, trackedRedDuringHold)

        if bar_index > bIdx and barstate.isconfirmed and inExecutableExitSession
            bool aATR = array.get(tActiveATR, i)

            if aATR
                float currMaxH = math.max(prevMaxH, high)
                float atrMaxRun = ((currMaxH - ent) / ent) * 100
                bool atrRunnerNow = array.get(tRunnerATR, i) or atrMaxRun >= runnerTriggerPct
                array.set(tRunnerATR, i, atrRunnerNow)

                float atrEarlyStop = ent - (early_atr_mult * atr14)
                float atrRunnerStop = currMaxH * (1 - trailStopPct / 100)
                bool atrTimeExit = enableCheckPoint and (bar_index - bIdx) >= checkPointBars and (((close - ent) / ent) * 100 - estRoundTripCostPct) < checkPointMaxGainPct
                bool atrEarlyExit = (not atrRunnerNow and close < atrEarlyStop) or atrTimeExit
                bool atrRunnerExit = atrRunnerNow and close < atrRunnerStop

                if atrEarlyExit or atrRunnerExit
                    float atrExitPrice = close
                    float pATRGross = ((atrExitPrice - ent) / ent) * 100
                    float pATR = pATRGross - estRoundTripCostPct
                    profitATR += pATR
                    if pATR > 0
                        winsATR += 1
                    closedTradesATR += 1
                    if trackedEntryType == "BUY"
                        buyClosedStats += 1
                        buyProfitStats += pATR
                        buyBestTradeStats := math.max(buyBestTradeStats, pATR)
                        if pATR > 0
                            buyWinsStats += 1
                        if not atrEarlyExit
                            buySurvivedStats += 1
                            buySurvivedProfitStats += pATR
                    else if trackedEntryType == "BUY_PLUS"
                        buyPlusClosedStats += 1
                        buyPlusProfitStats += pATR
                        buyPlusBestTradeStats := math.max(buyPlusBestTradeStats, pATR)
                        if pATR > 0
                            buyPlusWinsStats += 1
                        if not atrEarlyExit
                            buyPlusSurvivedStats += 1
                            buyPlusSurvivedProfitStats += pATR
                    else if trackedEntryType == "PB_PLUS"
                        pbPlusClosedStats += 1
                        pbPlusProfitStats += pATR
                        pbPlusBestTradeStats := math.max(pbPlusBestTradeStats, pATR)
                        if pATR > 0
                            pbPlusWinsStats += 1
                        if not atrEarlyExit
                            pbPlusSurvivedStats += 1
                            pbPlusSurvivedProfitStats += pATR
                    else if trackedEntryType == "RALLY_BUY"
                        rallyClosedStats += 1
                        rallyProfitStats += pATR
                        rallyBestTradeStats := math.max(rallyBestTradeStats, pATR)
                        if pATR > 0
                            rallyWinsStats += 1
                        if not atrEarlyExit
                            rallySurvivedStats += 1
                            rallySurvivedProfitStats += pATR
                    else if trackedEntryType == "FAST_MOMENTUM_BUY"
                        fastClosedStats += 1
                        fastProfitStats += pATR
                        fastBestTradeStats := math.max(fastBestTradeStats, pATR)
                        if pATR > 0
                            fastWinsStats += 1
                        if not atrEarlyExit
                            fastSurvivedStats += 1
                            fastSurvivedProfitStats += pATR
                    else if trackedEntryType == "FAST_EARLY_BUY"
                        fastEarlyClosedStats += 1
                        fastEarlyProfitStats += pATR
                        fastEarlyBestTradeStats := math.max(fastEarlyBestTradeStats, pATR)
                        if pATR > 0
                            fastEarlyWinsStats += 1
                        if not atrEarlyExit
                            fastEarlySurvivedStats += 1
                            fastEarlySurvivedProfitStats += pATR
                    else if trackedEntryType == "TEN_MIN_TURN_BUY"
                        turnClosedStats += 1
                        turnProfitStats += pATR
                        turnBestTradeStats := math.max(turnBestTradeStats, pATR)
                        if pATR > 0
                            turnWinsStats += 1
                        if not atrEarlyExit
                            turnSurvivedStats += 1
                            turnSurvivedProfitStats += pATR
                    else if trackedEntryType == "EARLY_REBOUND_BUY"
                        reboundClosedStats += 1
                        reboundProfitStats += pATR
                        reboundBestTradeStats := math.max(reboundBestTradeStats, pATR)
                        if pATR > 0
                            reboundWinsStats += 1
                        if not atrEarlyExit
                            reboundSurvivedStats += 1
                            reboundSurvivedProfitStats += pATR
                    else if trackedEntryType == "VWAP_RECLAIM_BUY"
                        vwapReclaimClosedStats += 1
                        vwapReclaimProfitStats += pATR
                        vwapReclaimBestTradeStats := math.max(vwapReclaimBestTradeStats, pATR)
                        if pATR > 0
                            vwapReclaimWinsStats += 1
                        if not atrEarlyExit
                            vwapReclaimSurvivedStats += 1
                            vwapReclaimSurvivedProfitStats += pATR
                    array.push(statsWindowTimes, time)
                    array.push(statsWindowProfitPcts, pATR)
                    array.push(statsWindowEarlyStopFlags, atrEarlyExit)
                    array.push(statsWindowTypes, trackedEntryType)
                    array.push(statsWindowRedMarketFlags, trackedRedDuringHold)
                    array.push(statsWindowChopFlags, trackedChopAtEntry)
                    if enableFalseSignalPressure
                        array.push(falsePressureTimes, time)
                        array.push(falsePressureProfitPcts, pATR)
                        array.push(falsePressureFalseFlags, false)
                        array.push(falsePressureRedMarketFlags, trackedRedDuringHold)
                        array.push(falsePressureEarlyStopFlags, atrEarlyExit)
                        array.push(falsePressureTypes, trackedEntryType)
                    if atrEarlyExit
                        if trackedEntryType == "BUY"
                            buyEarlyStopStats += 1
                        else if trackedEntryType == "BUY_PLUS"
                            buyPlusEarlyStopStats += 1
                        else if trackedEntryType == "PB_PLUS"
                            pbPlusEarlyStopStats += 1
                        else if trackedEntryType == "RALLY_BUY"
                            rallyEarlyStopStats += 1
                        else if trackedEntryType == "FAST_MOMENTUM_BUY"
                            fastEarlyStopStats += 1
                        else if trackedEntryType == "FAST_EARLY_BUY"
                            fastEarlyEarlyStopStats += 1
                        else if trackedEntryType == "TEN_MIN_TURN_BUY"
                            turnEarlyStopStats += 1
                        else if trackedEntryType == "EARLY_REBOUND_BUY"
                            reboundEarlyStopStats += 1
                        else if trackedEntryType == "VWAP_RECLAIM_BUY"
                            vwapReclaimEarlyStopStats += 1
                    array.set(tActiveATR, i, false)

            if not array.get(tActiveATR, i)
                array.remove(tEntryPrices, i)
                array.remove(tMaxHighs, i)
                array.remove(tEntryBars, i)
                array.remove(tEntryTypesStats, i)
                array.remove(tActiveATR, i)
                array.remove(tRunnerATR, i)
                array.remove(tChopAtEntry, i)
                array.remove(tRedDuringHold, i)
            else
                array.set(tMaxHighs, i, math.max(prevMaxH, high))

if openingExecutableStatsSignal
    array.push(openingEntryPrices, close)
    array.push(openingMaxHighs, high)
    array.push(openingEntryBars, bar_index)
    array.push(openingActiveATR, true)
    array.push(openingRunnerATR, false)
    array.push(openingChopAtEntry, chopIsChoppyAtEntryStats)
    array.push(openingRedDuringHold, isMarketRiskOff)
    openingEntryStats += 1
    array.push(statsWindowEntryTimes, time)
    array.push(statsWindowEntryTypes, "OPENING_RANGE_RECLAIM")

if array.size(openingEntryPrices) > 0
    for i = array.size(openingEntryPrices) - 1 to 0
        float oEnt = array.get(openingEntryPrices, i)
        float oPrevMaxH = array.get(openingMaxHighs, i)
        int oBar = array.get(openingEntryBars, i)
        bool oChopAtEntry = array.get(openingChopAtEntry, i)
        bool oRedDuringHold = array.get(openingRedDuringHold, i) or isMarketRiskOff
        array.set(openingRedDuringHold, i, oRedDuringHold)

        if bar_index > oBar and array.get(openingActiveATR, i) and barstate.isconfirmed and inExecutableExitSession
            float oMaxH = math.max(oPrevMaxH, high)
            array.set(openingMaxHighs, i, oMaxH)
            float oMaxRun = ((oMaxH - oEnt) / oEnt) * 100
            bool oRunnerNow = array.get(openingRunnerATR, i) or oMaxRun >= runnerTriggerPct
            array.set(openingRunnerATR, i, oRunnerNow)

            float oEarlyStop = oEnt - (early_atr_mult * atr14)
            float oRunnerStop = oMaxH * (1 - trailStopPct / 100)
            bool oEarlyExit = not oRunnerNow and close < oEarlyStop
            bool oRunnerExit = oRunnerNow and close < oRunnerStop
            bool oTimeExit = (bar_index - oBar) >= openingStatsTimeoutBars

            if oEarlyExit or oRunnerExit or oTimeExit
                float oExitPrice = close
                float oProfitPctGross = ((oExitPrice - oEnt) / oEnt) * 100
                float oProfitPct = oProfitPctGross - estRoundTripCostPct
                openingProfit += oProfitPct
                openingBestTradeStats := math.max(openingBestTradeStats, oProfitPct)
                if oProfitPct > 0
                    openingWins += 1
                openingClosedTrades += 1
                if oEarlyExit
                    openingEarlyStopStats += 1
                else
                    openingSurvivedStats += 1
                    openingSurvivedProfitStats += oProfitPct
                array.push(statsWindowTimes, time)
                array.push(statsWindowProfitPcts, oProfitPct)
                array.push(statsWindowEarlyStopFlags, oEarlyExit)
                array.push(statsWindowTypes, "OPENING_RANGE_RECLAIM")
                array.push(statsWindowRedMarketFlags, oRedDuringHold)
                array.push(statsWindowChopFlags, oChopAtEntry)
                array.remove(openingEntryPrices, i)
                array.remove(openingMaxHighs, i)
                array.remove(openingEntryBars, i)
                array.remove(openingActiveATR, i)
                array.remove(openingRunnerATR, i)
                array.remove(openingChopAtEntry, i)
                array.remove(openingRedDuringHold, i)
// === Stats Gate Window (bounds gate/guard/selected inputs to statsWindowDays, instead of the full unbounded chart history) ===
int statsWindowCutoffTime = time - (statsWindowDays * 86400000)
int statsWindowEntryCutoffTime = statsWindowCutoffTime
if array.size(statsWindowTimes) > 0
    for sw = array.size(statsWindowTimes) - 1 to 0
        if array.get(statsWindowTimes, sw) < statsWindowCutoffTime
            array.remove(statsWindowTimes, sw)
            array.remove(statsWindowProfitPcts, sw)
            array.remove(statsWindowEarlyStopFlags, sw)
            array.remove(statsWindowTypes, sw)
            array.remove(statsWindowRedMarketFlags, sw)
            array.remove(statsWindowChopFlags, sw)
if array.size(statsWindowEntryTimes) > 0
    for sw = array.size(statsWindowEntryTimes) - 1 to 0
        if array.get(statsWindowEntryTimes, sw) < statsWindowEntryCutoffTime
            array.remove(statsWindowEntryTimes, sw)
            array.remove(statsWindowEntryTypes, sw)
if array.size(selectedWindowExitTimes) > 0
    for sw = array.size(selectedWindowExitTimes) - 1 to 0
        if array.get(selectedWindowExitTimes, sw) < statsWindowCutoffTime
            array.remove(selectedWindowExitTimes, sw)
            array.remove(selectedWindowProfitPcts, sw)
            array.remove(selectedWindowEarlyStopFlags, sw)
if array.size(selectedWindowEntryTimes) > 0
    for sw = array.size(selectedWindowEntryTimes) - 1 to 0
        if array.get(selectedWindowEntryTimes, sw) < statsWindowEntryCutoffTime
            array.remove(selectedWindowEntryTimes, sw)

// === DATA COVERAGE DIAGNOSTIC ===
var int firstBarTimeSeen = na
if na(firstBarTimeSeen)
    firstBarTimeSeen := time
float chartHistoryDays = (time - firstBarTimeSeen) / 86400000.0
float oldestClosedTradeDays = array.size(statsWindowTimes) > 0 ? (time - array.min(statsWindowTimes)) / 86400000.0 : 0.0
bool dataCoverageOk = chartHistoryDays >= statsWindowDays * 0.9
string dataCoverageLabel = dataCoverageOk ? "OK" : "TRUNCATED"
color dataCoverageColor = dataCoverageOk ? color.lime : color.red

f_window_key(string t) =>
    t == "BUY" ? "BUY" : t == "BUY_PLUS" ? "BUY_PLUS" : t == "PB_PLUS" ? "PB_PLUS" : (t == "RALLY_BUY" or t == "RALLY_RECOVERY_PB") ? "RALLY" : t == "FAST_MOMENTUM_BUY" ? "FAST" : t == "FAST_EARLY_BUY" ? "FAST_EARLY" : t == "TEN_MIN_TURN_BUY" ? "TURN" : t == "EARLY_REBOUND_BUY" ? "EARLY_REBOUND_BUY" : t == "VWAP_RECLAIM_BUY" ? "VWAP_RECLAIM" : (t == "OPENING_RANGE_RECLAIM" or t == "OPENING_DRIVE_EXCEPTION") ? "OPEN" : "NONE"

f_stats_window_metrics(string key) =>
    int wClosed = 0
    int wWins = 0
    float wNet = 0.0
    float wBest = 0.0
    int wStops = 0
    int wSurvived = 0
    float wSurvivedProfit = 0.0
    int wGuardRemoved = 0
    float wGuardRemovedNet = 0.0
    int wGuardRemovedStops = 0
    int wGuardRemovedRuns = 0
    float wGuardRemovedRunNet = 0.0
    if array.size(statsWindowTimes) > 0
        for k = 0 to array.size(statsWindowTimes) - 1
            if f_window_key(array.get(statsWindowTypes, k)) == key
                float kProfit = array.get(statsWindowProfitPcts, k)
                bool kEarlyStop = array.get(statsWindowEarlyStopFlags, k)
                bool kRedMarket = array.get(statsWindowRedMarketFlags, k)
                wClosed += 1
                wNet += kProfit
                wBest := math.max(wBest, kProfit)
                if kProfit > 0
                    wWins += 1
                if kEarlyStop
                    wStops += 1
                else
                    wSurvived += 1
                    wSurvivedProfit += kProfit
                if kRedMarket and kProfit < 0
                    wGuardRemoved += 1
                    wGuardRemovedNet += kProfit
                    if kEarlyStop
                        wGuardRemovedStops += 1
                    else
                        wGuardRemovedRuns += 1
                        wGuardRemovedRunNet += kProfit
    int wEntries = 0
    if array.size(statsWindowEntryTimes) > 0
        for k = 0 to array.size(statsWindowEntryTimes) - 1
            if f_window_key(array.get(statsWindowEntryTypes, k)) == key
                wEntries += 1
    [wEntries, wClosed, wWins, wNet, wBest, wStops, wSurvived, wSurvivedProfit, wGuardRemoved, wGuardRemovedNet, wGuardRemovedStops, wGuardRemovedRuns, wGuardRemovedRunNet]

f_selected_window_metrics() =>
    int sEntries = array.size(selectedWindowEntryTimes)
    int sClosed = 0
    int sWins = 0
    float sNet = 0.0
    int sStops = 0
    int sSurvived = 0
    float sSurvivedProfit = 0.0
    if array.size(selectedWindowExitTimes) > 0
        for k = 0 to array.size(selectedWindowExitTimes) - 1
            float kProfit = array.get(selectedWindowProfitPcts, k)
            bool kEarlyStop = array.get(selectedWindowEarlyStopFlags, k)
            sClosed += 1
            sNet += kProfit
            if kProfit > 0
                sWins += 1
            if kEarlyStop
                sStops += 1
            else
                sSurvived += 1
                sSurvivedProfit += kProfit
    [sEntries, sClosed, sWins, sNet, sStops, sSurvived, sSurvivedProfit]

[buyWEntries, buyWClosed, buyWWins, buyWNet, buyWBest, buyWStops, buyWSurvived, buyWSurvivedProfit, buyWGuardRemoved, buyWGuardRemovedNet, buyWGuardRemovedStops, buyWGuardRemovedRuns, buyWGuardRemovedRunNet] = f_stats_window_metrics("BUY")
[buyPlusWEntries, buyPlusWClosed, buyPlusWWins, buyPlusWNet, buyPlusWBest, buyPlusWStops, buyPlusWSurvived, buyPlusWSurvivedProfit, buyPlusWGuardRemoved, buyPlusWGuardRemovedNet, buyPlusWGuardRemovedStops, buyPlusWGuardRemovedRuns, buyPlusWGuardRemovedRunNet] = f_stats_window_metrics("BUY_PLUS")
[pbPlusWEntries, pbPlusWClosed, pbPlusWWins, pbPlusWNet, pbPlusWBest, pbPlusWStops, pbPlusWSurvived, pbPlusWSurvivedProfit, pbPlusWGuardRemoved, pbPlusWGuardRemovedNet, pbPlusWGuardRemovedStops, pbPlusWGuardRemovedRuns, pbPlusWGuardRemovedRunNet] = f_stats_window_metrics("PB_PLUS")
[rallyWEntries, rallyWClosed, rallyWWins, rallyWNet, rallyWBest, rallyWStops, rallyWSurvived, rallyWSurvivedProfit, rallyWGuardRemoved, rallyWGuardRemovedNet, rallyWGuardRemovedStops, rallyWGuardRemovedRuns, rallyWGuardRemovedRunNet] = f_stats_window_metrics("RALLY")
[fastWEntries, fastWClosed, fastWWins, fastWNet, fastWBest, fastWStops, fastWSurvived, fastWSurvivedProfit, fastWGuardRemoved, fastWGuardRemovedNet, fastWGuardRemovedStops, fastWGuardRemovedRuns, fastWGuardRemovedRunNet] = f_stats_window_metrics("FAST")
[fastEarlyWEntries, fastEarlyWClosed, fastEarlyWWins, fastEarlyWNet, fastEarlyWBest, fastEarlyWStops, fastEarlyWSurvived, fastEarlyWSurvivedProfit, fastEarlyWGuardRemoved, fastEarlyWGuardRemovedNet, fastEarlyWGuardRemovedStops, fastEarlyWGuardRemovedRuns, fastEarlyWGuardRemovedRunNet] = f_stats_window_metrics("FAST_EARLY")
[turnWEntries, turnWClosed, turnWWins, turnWNet, turnWBest, turnWStops, turnWSurvived, turnWSurvivedProfit, turnWGuardRemoved, turnWGuardRemovedNet, turnWGuardRemovedStops, turnWGuardRemovedRuns, turnWGuardRemovedRunNet] = f_stats_window_metrics("TURN")
[reboundWEntries, reboundWClosed, reboundWWins, reboundWNet, reboundWBest, reboundWStops, reboundWSurvived, reboundWSurvivedProfit, reboundWGuardRemoved, reboundWGuardRemovedNet, reboundWGuardRemovedStops, reboundWGuardRemovedRuns, reboundWGuardRemovedRunNet] = f_stats_window_metrics("EARLY_REBOUND_BUY")
[vwapReclaimWEntries, vwapReclaimWClosed, vwapReclaimWWins, vwapReclaimWNet, vwapReclaimWBest, vwapReclaimWStops, vwapReclaimWSurvived, vwapReclaimWSurvivedProfit, vwapReclaimWGuardRemoved, vwapReclaimWGuardRemovedNet, vwapReclaimWGuardRemovedStops, vwapReclaimWGuardRemovedRuns, vwapReclaimWGuardRemovedRunNet] = f_stats_window_metrics("VWAP_RECLAIM")
[openingWEntries, openingWClosed, openingWWins, openingWNet, openingWBest, openingWStops, openingWSurvived, openingWSurvivedProfit, openingWGuardRemoved, openingWGuardRemovedNet, openingWGuardRemovedStops, openingWGuardRemovedRuns, openingWGuardRemovedRunNet] = f_stats_window_metrics("OPEN")
[selectedWEntries, selectedWClosed, selectedWWins, selectedWNet, selectedWStops, selectedWSurvived, selectedWSurvivedProfit] = f_selected_window_metrics()

f_chop_bucket_metrics(bool wantChoppy) =>
    int bClosed = 0
    int bWins = 0
    float bNet = 0.0
    int bStops = 0
    float bGrossWin = 0.0
    float bGrossLoss = 0.0
    if array.size(statsWindowTimes) > 0
        for k = 0 to array.size(statsWindowTimes) - 1
            if array.get(statsWindowChopFlags, k) == wantChoppy
                float kProfit = array.get(statsWindowProfitPcts, k)
                bool kEarlyStop = array.get(statsWindowEarlyStopFlags, k)
                bClosed += 1
                bNet += kProfit
                if kProfit > 0
                    bWins += 1
                    bGrossWin += kProfit
                else
                    bGrossLoss += math.abs(kProfit)
                if kEarlyStop
                    bStops += 1
    [bClosed, bWins, bNet, bStops, bGrossWin, bGrossLoss]

f_profit_factor(float grossWin, float grossLoss) =>
    grossLoss > 0 ? grossWin / grossLoss : (grossWin > 0 ? 9.99 : 0.0)

[chopFlaggedClosed, chopFlaggedWins, chopFlaggedNet, chopFlaggedStops, chopFlaggedGrossWin, chopFlaggedGrossLoss] = f_chop_bucket_metrics(true)
[chopNormalClosed, chopNormalWins, chopNormalNet, chopNormalStops, chopNormalGrossWin, chopNormalGrossLoss] = f_chop_bucket_metrics(false)
float chopFlaggedWinRate = chopFlaggedClosed > 0 ? (chopFlaggedWins * 100.0 / chopFlaggedClosed) : 0.0
float chopNormalWinRate = chopNormalClosed > 0 ? (chopNormalWins * 100.0 / chopNormalClosed) : 0.0
float chopFlaggedNetPerTrade = chopFlaggedClosed > 0 ? chopFlaggedNet / chopFlaggedClosed : 0.0
float chopNormalNetPerTrade = chopNormalClosed > 0 ? chopNormalNet / chopNormalClosed : 0.0
float chopFlaggedStopRate = chopFlaggedClosed > 0 ? (chopFlaggedStops * 100.0 / chopFlaggedClosed) : 0.0
float chopNormalStopRate = chopNormalClosed > 0 ? (chopNormalStops * 100.0 / chopNormalClosed) : 0.0
float chopFlaggedProfitFactor = f_profit_factor(chopFlaggedGrossWin, chopFlaggedGrossLoss)
float chopNormalProfitFactor = f_profit_factor(chopNormalGrossWin, chopNormalGrossLoss)
float chopNetPerTradeEdge = chopNormalNetPerTrade - chopFlaggedNetPerTrade
float chopProfitFactorEdge = chopNormalProfitFactor - chopFlaggedProfitFactor
bool chopHasSample = chopFlaggedClosed >= statsGateMinSample and chopNormalClosed >= statsGateMinSample
string chopVerdict = not chopHasSample ? "NOT ENOUGH DATA" : chopNetPerTradeEdge > 0.3 ? "FILTER LIKELY HELPS" : chopNetPerTradeEdge < -0.3 ? "FILTER LIKELY HURTS" : "NO CLEAR EDGE"
color chopVerdictColor = not chopHasSample ? color.gray : chopNetPerTradeEdge > 0.3 ? color.lime : chopNetPerTradeEdge < -0.3 ? color.red : color.yellow

buyEntryStats := buyWEntries
buyClosedStats := buyWClosed
buyWinsStats := buyWWins
buyProfitStats := buyWNet
buyBestTradeStats := buyWBest
buyEarlyStopStats := buyWStops
buySurvivedStats := buyWSurvived
buySurvivedProfitStats := buyWSurvivedProfit

buyPlusEntryStats := buyPlusWEntries
buyPlusClosedStats := buyPlusWClosed
buyPlusWinsStats := buyPlusWWins
buyPlusProfitStats := buyPlusWNet
buyPlusBestTradeStats := buyPlusWBest
buyPlusEarlyStopStats := buyPlusWStops
buyPlusSurvivedStats := buyPlusWSurvived
buyPlusSurvivedProfitStats := buyPlusWSurvivedProfit

pbPlusEntryStats := pbPlusWEntries
pbPlusClosedStats := pbPlusWClosed
pbPlusWinsStats := pbPlusWWins
pbPlusProfitStats := pbPlusWNet
pbPlusBestTradeStats := pbPlusWBest
pbPlusEarlyStopStats := pbPlusWStops
pbPlusSurvivedStats := pbPlusWSurvived
pbPlusSurvivedProfitStats := pbPlusWSurvivedProfit

rallyEntryStats := rallyWEntries
rallyClosedStats := rallyWClosed
rallyWinsStats := rallyWWins
rallyProfitStats := rallyWNet
rallyBestTradeStats := rallyWBest
rallyEarlyStopStats := rallyWStops
rallySurvivedStats := rallyWSurvived
rallySurvivedProfitStats := rallyWSurvivedProfit

fastEntryStats := fastWEntries
fastClosedStats := fastWClosed
fastWinsStats := fastWWins
fastProfitStats := fastWNet
fastBestTradeStats := fastWBest
fastEarlyStopStats := fastWStops
fastSurvivedStats := fastWSurvived
fastSurvivedProfitStats := fastWSurvivedProfit

fastEarlyEntryStats := fastEarlyWEntries
fastEarlyClosedStats := fastEarlyWClosed
fastEarlyWinsStats := fastEarlyWWins
fastEarlyProfitStats := fastEarlyWNet
fastEarlyBestTradeStats := fastEarlyWBest
fastEarlyEarlyStopStats := fastEarlyWStops
fastEarlySurvivedStats := fastEarlyWSurvived
fastEarlySurvivedProfitStats := fastEarlyWSurvivedProfit

turnEntryStats := turnWEntries
turnClosedStats := turnWClosed
turnWinsStats := turnWWins
turnProfitStats := turnWNet
turnBestTradeStats := turnWBest
turnEarlyStopStats := turnWStops
turnSurvivedStats := turnWSurvived
turnSurvivedProfitStats := turnWSurvivedProfit

reboundEntryStats := reboundWEntries
reboundClosedStats := reboundWClosed
reboundWinsStats := reboundWWins
reboundProfitStats := reboundWNet
reboundBestTradeStats := reboundWBest
reboundEarlyStopStats := reboundWStops
reboundSurvivedStats := reboundWSurvived
reboundSurvivedProfitStats := reboundWSurvivedProfit

vwapReclaimEntryStats := vwapReclaimWEntries
vwapReclaimClosedStats := vwapReclaimWClosed
vwapReclaimWinsStats := vwapReclaimWWins
vwapReclaimProfitStats := vwapReclaimWNet
vwapReclaimBestTradeStats := vwapReclaimWBest
vwapReclaimEarlyStopStats := vwapReclaimWStops
vwapReclaimSurvivedStats := vwapReclaimWSurvived
vwapReclaimSurvivedProfitStats := vwapReclaimWSurvivedProfit

openingEntryStats := openingWEntries
openingClosedTrades := openingWClosed
openingWins := openingWWins
openingProfit := openingWNet
openingBestTradeStats := openingWBest
openingEarlyStopStats := openingWStops
openingSurvivedStats := openingWSurvived
openingSurvivedProfitStats := openingWSurvivedProfit

winRateATR = closedTradesATR > 0 ? (winsATR * 1.0 / closedTradesATR) * 100 : 0.0
openingWinRate = openingClosedTrades > 0 ? (openingWins * 1.0 / openingClosedTrades) * 100 : 0.0
buyWinRateStats = buyClosedStats > 0 ? (buyWinsStats * 1.0 / buyClosedStats) * 100 : 0.0
buyPlusWinRateStats = buyPlusClosedStats > 0 ? (buyPlusWinsStats * 1.0 / buyPlusClosedStats) * 100 : 0.0
pbPlusWinRateStats = pbPlusClosedStats > 0 ? (pbPlusWinsStats * 1.0 / pbPlusClosedStats) * 100 : 0.0
rallyWinRateStats = rallyClosedStats > 0 ? (rallyWinsStats * 1.0 / rallyClosedStats) * 100 : 0.0
fastWinRateStats = fastClosedStats > 0 ? (fastWinsStats * 1.0 / fastClosedStats) * 100 : 0.0
fastEarlyWinRateStats = fastEarlyClosedStats > 0 ? (fastEarlyWinsStats * 1.0 / fastEarlyClosedStats) * 100 : 0.0
turnWinRateStats = turnClosedStats > 0 ? (turnWinsStats * 1.0 / turnClosedStats) * 100 : 0.0
reboundWinRateStats = reboundClosedStats > 0 ? (reboundWinsStats * 1.0 / reboundClosedStats) * 100 : 0.0
vwapReclaimWinRateStats = vwapReclaimClosedStats > 0 ? (vwapReclaimWinsStats * 1.0 / vwapReclaimClosedStats) * 100 : 0.0
buyEarlyStopRate = buyEntryStats > 0 ? (buyEarlyStopStats * 1.0 / buyEntryStats) * 100 : 0.0
buyPlusEarlyStopRate = buyPlusEntryStats > 0 ? (buyPlusEarlyStopStats * 1.0 / buyPlusEntryStats) * 100 : 0.0
pbPlusEarlyStopRate = pbPlusEntryStats > 0 ? (pbPlusEarlyStopStats * 1.0 / pbPlusEntryStats) * 100 : 0.0
rallyEarlyStopRate = rallyEntryStats > 0 ? (rallyEarlyStopStats * 1.0 / rallyEntryStats) * 100 : 0.0
fastEarlyStopRate = fastEntryStats > 0 ? (fastEarlyStopStats * 1.0 / fastEntryStats) * 100 : 0.0
fastEarlyEarlyStopRate = fastEarlyEntryStats > 0 ? (fastEarlyEarlyStopStats * 1.0 / fastEarlyEntryStats) * 100 : 0.0
turnEarlyStopRate = turnEntryStats > 0 ? (turnEarlyStopStats * 1.0 / turnEntryStats) * 100 : 0.0
reboundEarlyStopRate = reboundEntryStats > 0 ? (reboundEarlyStopStats * 1.0 / reboundEntryStats) * 100 : 0.0
vwapReclaimEarlyStopRate = vwapReclaimEntryStats > 0 ? (vwapReclaimEarlyStopStats * 1.0 / vwapReclaimEntryStats) * 100 : 0.0
openingEarlyStopRate = openingEntryStats > 0 ? (openingEarlyStopStats * 1.0 / openingEntryStats) * 100 : 0.0
buyEarlyStopRateClosed = buyClosedStats > 0 ? (buyEarlyStopStats * 1.0 / buyClosedStats) * 100 : 0.0
buyPlusEarlyStopRateClosed = buyPlusClosedStats > 0 ? (buyPlusEarlyStopStats * 1.0 / buyPlusClosedStats) * 100 : 0.0
pbPlusEarlyStopRateClosed = pbPlusClosedStats > 0 ? (pbPlusEarlyStopStats * 1.0 / pbPlusClosedStats) * 100 : 0.0
rallyEarlyStopRateClosed = rallyClosedStats > 0 ? (rallyEarlyStopStats * 1.0 / rallyClosedStats) * 100 : 0.0
fastEarlyStopRateClosed = fastClosedStats > 0 ? (fastEarlyStopStats * 1.0 / fastClosedStats) * 100 : 0.0
fastEarlyEarlyStopRateClosed = fastEarlyClosedStats > 0 ? (fastEarlyEarlyStopStats * 1.0 / fastEarlyClosedStats) * 100 : 0.0
turnEarlyStopRateClosed = turnClosedStats > 0 ? (turnEarlyStopStats * 1.0 / turnClosedStats) * 100 : 0.0
reboundEarlyStopRateClosed = reboundClosedStats > 0 ? (reboundEarlyStopStats * 1.0 / reboundClosedStats) * 100 : 0.0
vwapReclaimEarlyStopRateClosed = vwapReclaimClosedStats > 0 ? (vwapReclaimEarlyStopStats * 1.0 / vwapReclaimClosedStats) * 100 : 0.0
openingEarlyStopRateClosed = openingClosedTrades > 0 ? (openingEarlyStopStats * 1.0 / openingClosedTrades) * 100 : 0.0

f_clamp(x, lo, hi) =>
    math.max(lo, math.min(hi, x))

f_chop_confidence_score(int flaggedClosed, int normalClosed, float pfEdge, float netEdge) =>
    int totalClosed = flaggedClosed + normalClosed
    int minBucket = math.min(flaggedClosed, normalClosed)
    float sampleScore = f_clamp((totalClosed * 1.0 / 60.0) * 100, 0, 100)
    float balanceScore = f_clamp((minBucket * 1.0 / 15.0) * 100, 0, 100)
    float pfScore = f_clamp(50 + (pfEdge * 25), 0, 100)
    float netEdgeScore = f_clamp(50 + (netEdge * 20), 0, 100)
    int(math.round((sampleScore * 0.25) + (balanceScore * 0.20) + (pfScore * 0.30) + (netEdgeScore * 0.25)))

chopConfidenceScore = f_chop_confidence_score(chopFlaggedClosed, chopNormalClosed, chopProfitFactorEdge, chopNetPerTradeEdge)
chopMinConfidence = input.int(55, "Chop Guard Min Confidence Score (0-100) to auto-arm", minval=0, maxval=100, group=chopGroup)

float chopWithoutFilterNet = chopFlaggedNet + chopNormalNet
int chopWithoutFilterClosed = chopFlaggedClosed + chopNormalClosed
float chopWithoutFilterNetPerTrade = chopWithoutFilterClosed > 0 ? chopWithoutFilterNet / chopWithoutFilterClosed : 0.0
float chopWithoutFilterWinRate = chopWithoutFilterClosed > 0 ? ((chopFlaggedWins + chopNormalWins) * 100.0 / chopWithoutFilterClosed) : 0.0

f_use_chop_filter(bool sampleOk, int confidenceScore, int minConfidence, float withoutNetPerTrade, float withNetPerTrade, float withoutWinRate, float withWinRate) =>
    sampleOk and confidenceScore >= minConfidence and (withNetPerTrade > withoutNetPerTrade or (withNetPerTrade == withoutNetPerTrade and withWinRate > withoutWinRate))

useChopFilterAuto = f_use_chop_filter(chopHasSample, chopConfidenceScore, chopMinConfidence, chopWithoutFilterNetPerTrade, chopNormalNetPerTrade, chopWithoutFilterWinRate, chopNormalWinRate)
chopBlockActive = enableChopFilter and useChopFilterAuto and chopThresholdCrossed
string chopArmedLabel = not enableChopFilter ? "MASTER OFF" : useChopFilterAuto and chopThresholdCrossed ? "BLOCKING NOW" : useChopFilterAuto ? "ARMED (clear)" : chopHasSample ? "STANDBY (low conf)" : "STANDBY (no data)"
color chopArmedColor = not enableChopFilter ? color.gray : useChopFilterAuto and chopThresholdCrossed ? color.red : useChopFilterAuto ? color.lime : color.yellow

f_sample_factor(n) =>
    n >= 20 ? 1.0 : n >= 10 ? 0.95 : n >= 5 ? 0.85 : n > 0 ? 0.7 : 0.0

f_quality_score(wr, netProfit, survivedProfit, earlyStopRate, sampleCount) =>
    float netPerTrade = sampleCount > 0 ? netProfit / sampleCount : 0.0
    float profitScore = f_clamp((netPerTrade / 1.5) * 100, 0, 100)
    float winScore = f_clamp(((wr - 35.0) / 35.0) * 100, 0, 100)
    float sampleScore = f_clamp((sampleCount * 1.0 / 30.0) * 100, 0, 100)
    float stopPenalty = earlyStopRate > statsGateMaxEarlyStopRatePct ? (earlyStopRate - statsGateMaxEarlyStopRatePct) * 1.2 : 0.0
    int(math.round(f_clamp((profitScore * 0.45) + (winScore * 0.40) + (sampleScore * 0.15) - stopPenalty, 0, 100)))

f_quality_fail(wr, netProfit, survivedProfit, sampleCount) =>
    sampleCount >= 20 and netProfit < 0 and survivedProfit <= 0 and wr < 40

f_quality_text(score, sampleCount, isFail) =>
    (isFail ? "FAIL " : "") + str.tostring(score) + "% (" + str.tostring(sampleCount) + ")"

// === Unique-days-in-sample diagnostic (DISPLAY ONLY — does not feed any gate, quality score, or execution) ===
// Answers "how many distinct calendar days does this tactic's closed-trade sample actually span" so a
// large trade COUNT can be checked against sample BREADTH before trusting it. Reuses the existing
// statsWindowTimes/statsWindowTypes arrays already maintained for the stats gate — no new tracking arrays,
// no change to what closes a trade or what passes a gate.
f_unique_days_count(string key, bool excludeGuardLosses) =>
    int[] seenDayKeys = array.new_int()
    int cnt = 0
    if array.size(statsWindowTimes) > 0
        for k = 0 to array.size(statsWindowTimes) - 1
            if f_window_key(array.get(statsWindowTypes, k)) == key
                bool isGuardRemovedTrade = excludeGuardLosses and array.get(statsWindowRedMarketFlags, k) and array.get(statsWindowProfitPcts, k) < 0
                if not isGuardRemovedTrade
                    int dayKey = int(array.get(statsWindowTimes, k) / 86400000)
                    if not array.includes(seenDayKeys, dayKey)
                        array.push(seenDayKeys, dayKey)
                        cnt += 1
    cnt

f_gate_color(isGateOk) =>
    isGateOk ? color.lime : color.white

f_gate_bg(isGateOk) =>
    isGateOk ? color.rgb(18, 76, 45) : color.rgb(92, 30, 36)

f_best_trade_share(netProfit, bestTrade) =>
    netProfit > 0 and bestTrade > 0 ? (bestTrade / netProfit) * 100 : 0.0

f_net_without_best(netProfit, bestTrade) =>
    netProfit - math.max(bestTrade, 0.0)

f_stats_gate_ok(winRate, sampleCount, netPerTrade, netProfit, bestTrade, earlyStopRate) =>
    float netWithoutBest = f_net_without_best(netProfit, bestTrade)
    float bestTradeShare = f_best_trade_share(netProfit, bestTrade)
    bool consistencyOk = netWithoutBest > 0 and bestTradeShare <= statsGateMaxBestTradeSharePct
    bool stopOk = earlyStopRate <= statsGateMaxEarlyStopRatePct
    not enableStatsGate or (winRate >= statsGateMinWinRatePct and sampleCount >= statsGateMinSample and netPerTrade >= statsGateMinNetPerTradePct and consistencyOk and stopOk)

f_guard_closed(baseClosed, removedLosses) =>
    math.max(baseClosed - removedLosses, 0)

f_guard_profit(baseProfit, removedNet) =>
    baseProfit - removedNet

f_guard_win_rate(baseWinRate, baseClosed, removedLosses) =>
    int guardClosed = f_guard_closed(baseClosed, removedLosses)
    guardClosed > 0 ? math.min(100.0, baseWinRate * baseClosed / guardClosed) : 0.0

f_guard_net_per_trade(baseProfit, baseClosed, removedLosses, removedNet) =>
    int guardClosed = f_guard_closed(baseClosed, removedLosses)
    guardClosed > 0 ? f_guard_profit(baseProfit, removedNet) / guardClosed : 0.0

f_guard_stop_rate(baseEntries, baseStops, removedLosses, removedStops) =>
    int guardEntries = math.max(baseEntries - removedLosses, 0)
    int guardStops = math.max(baseStops - removedStops, 0)
    guardEntries > 0 ? (guardStops * 1.0 / guardEntries) * 100 : 0.0

f_guard_stop_rate_closed(baseClosed, baseStops, removedLosses, removedStops) =>
    int guardClosed = math.max(baseClosed - removedLosses, 0)
    int guardStops = math.max(baseStops - removedStops, 0)
    guardClosed > 0 ? (guardStops * 1.0 / guardClosed) * 100 : 0.0

f_guard_quality(baseWinRate, baseProfit, baseSurvivedProfit, guardEarlyStopRate, baseClosed, removedLosses, removedNet) =>
    int guardClosed = f_guard_closed(baseClosed, removedLosses)
    float guardProfit = f_guard_profit(baseProfit, removedNet)
    float guardWinRate = f_guard_win_rate(baseWinRate, baseClosed, removedLosses)
    f_quality_score(guardWinRate, guardProfit, baseSurvivedProfit, guardEarlyStopRate, guardClosed)

f_guard_use(baseGateOk, guardGateOk, baseAvg, guardAvg, baseWinRate, guardWinRate, removedLosses) =>
    removedLosses > 0 and guardGateOk and (not baseGateOk or guardAvg > baseAvg or (guardAvg == baseAvg and guardWinRate > baseWinRate))

f_is_better_candidate(candidateQuality, candidateNetPerTrade, candidatePriority, bestQuality, bestNetPerTrade, bestPriority) =>
    bool betterQuality = candidateQuality > bestQuality
    bool betterNet = candidateQuality == bestQuality and candidateNetPerTrade > bestNetPerTrade
    bool betterPriority = candidateQuality == bestQuality and candidateNetPerTrade == bestNetPerTrade and candidatePriority < bestPriority
    betterQuality or betterNet or betterPriority

buyQualityScore = f_quality_score(buyWinRateStats, buyProfitStats, buySurvivedProfitStats, buyEarlyStopRateClosed, buyClosedStats)
buyPlusQualityScore = f_quality_score(buyPlusWinRateStats, buyPlusProfitStats, buyPlusSurvivedProfitStats, buyPlusEarlyStopRateClosed, buyPlusClosedStats)
pbPlusQualityScore = f_quality_score(pbPlusWinRateStats, pbPlusProfitStats, pbPlusSurvivedProfitStats, pbPlusEarlyStopRateClosed, pbPlusClosedStats)
rallyQualityScore = f_quality_score(rallyWinRateStats, rallyProfitStats, rallySurvivedProfitStats, rallyEarlyStopRateClosed, rallyClosedStats)
fastQualityScore = f_quality_score(fastWinRateStats, fastProfitStats, fastSurvivedProfitStats, fastEarlyStopRateClosed, fastClosedStats)
fastEarlyQualityScore = f_quality_score(fastEarlyWinRateStats, fastEarlyProfitStats, fastEarlySurvivedProfitStats, fastEarlyEarlyStopRateClosed, fastEarlyClosedStats)
turnQualityScore = f_quality_score(turnWinRateStats, turnProfitStats, turnSurvivedProfitStats, turnEarlyStopRateClosed, turnClosedStats)
reboundQualityScore = f_quality_score(reboundWinRateStats, reboundProfitStats, reboundSurvivedProfitStats, reboundEarlyStopRateClosed, reboundClosedStats)
vwapReclaimQualityScore = f_quality_score(vwapReclaimWinRateStats, vwapReclaimProfitStats, vwapReclaimSurvivedProfitStats, vwapReclaimEarlyStopRateClosed, vwapReclaimClosedStats)
openingQualityScore = f_quality_score(openingWinRate, openingProfit, openingSurvivedProfitStats, openingEarlyStopRateClosed, openingClosedTrades)
buyNetPerTrade = buyClosedStats > 0 ? buyProfitStats / buyClosedStats : 0.0
buyPlusNetPerTrade = buyPlusClosedStats > 0 ? buyPlusProfitStats / buyPlusClosedStats : 0.0
pbPlusNetPerTrade = pbPlusClosedStats > 0 ? pbPlusProfitStats / pbPlusClosedStats : 0.0
rallyNetPerTrade = rallyClosedStats > 0 ? rallyProfitStats / rallyClosedStats : 0.0
fastNetPerTrade = fastClosedStats > 0 ? fastProfitStats / fastClosedStats : 0.0
fastEarlyNetPerTrade = fastEarlyClosedStats > 0 ? fastEarlyProfitStats / fastEarlyClosedStats : 0.0
turnNetPerTrade = turnClosedStats > 0 ? turnProfitStats / turnClosedStats : 0.0
reboundNetPerTrade = reboundClosedStats > 0 ? reboundProfitStats / reboundClosedStats : 0.0
vwapReclaimNetPerTrade = vwapReclaimClosedStats > 0 ? vwapReclaimProfitStats / vwapReclaimClosedStats : 0.0
openingNetPerTrade = openingClosedTrades > 0 ? openingProfit / openingClosedTrades : 0.0
buyQualityFail = f_quality_fail(buyWinRateStats, buyProfitStats, buySurvivedProfitStats, buyClosedStats)
buyPlusQualityFail = f_quality_fail(buyPlusWinRateStats, buyPlusProfitStats, buyPlusSurvivedProfitStats, buyPlusClosedStats)
pbPlusQualityFail = f_quality_fail(pbPlusWinRateStats, pbPlusProfitStats, pbPlusSurvivedProfitStats, pbPlusClosedStats)
rallyQualityFail = f_quality_fail(rallyWinRateStats, rallyProfitStats, rallySurvivedProfitStats, rallyClosedStats)
fastQualityFail = f_quality_fail(fastWinRateStats, fastProfitStats, fastSurvivedProfitStats, fastClosedStats)
fastEarlyQualityFail = f_quality_fail(fastEarlyWinRateStats, fastEarlyProfitStats, fastEarlySurvivedProfitStats, fastEarlyClosedStats)
turnQualityFail = f_quality_fail(turnWinRateStats, turnProfitStats, turnSurvivedProfitStats, turnClosedStats)
reboundQualityFail = f_quality_fail(reboundWinRateStats, reboundProfitStats, reboundSurvivedProfitStats, reboundClosedStats)
vwapReclaimQualityFail = f_quality_fail(vwapReclaimWinRateStats, vwapReclaimProfitStats, vwapReclaimSurvivedProfitStats, vwapReclaimClosedStats)
openingQualityFail = f_quality_fail(openingWinRate, openingProfit, openingSurvivedProfitStats, openingClosedTrades)
buyStatsGateOk = f_stats_gate_ok(buyWinRateStats, buyClosedStats, buyNetPerTrade, buyProfitStats, buyBestTradeStats, buyEarlyStopRateClosed)
buyPlusStatsGateOk = f_stats_gate_ok(buyPlusWinRateStats, buyPlusClosedStats, buyPlusNetPerTrade, buyPlusProfitStats, buyPlusBestTradeStats, buyPlusEarlyStopRateClosed)
pbPlusStatsGateOk = f_stats_gate_ok(pbPlusWinRateStats, pbPlusClosedStats, pbPlusNetPerTrade, pbPlusProfitStats, pbPlusBestTradeStats, pbPlusEarlyStopRateClosed)
rallyStatsGateOk = f_stats_gate_ok(rallyWinRateStats, rallyClosedStats, rallyNetPerTrade, rallyProfitStats, rallyBestTradeStats, rallyEarlyStopRateClosed)
fastStatsGateOk = f_stats_gate_ok(fastWinRateStats, fastClosedStats, fastNetPerTrade, fastProfitStats, fastBestTradeStats, fastEarlyStopRateClosed)
fastEarlyStatsGateOk = f_stats_gate_ok(fastEarlyWinRateStats, fastEarlyClosedStats, fastEarlyNetPerTrade, fastEarlyProfitStats, fastEarlyBestTradeStats, fastEarlyEarlyStopRateClosed)
turnStatsGateOk = f_stats_gate_ok(turnWinRateStats, turnClosedStats, turnNetPerTrade, turnProfitStats, turnBestTradeStats, turnEarlyStopRateClosed)
reboundStatsGateOk = f_stats_gate_ok(reboundWinRateStats, reboundClosedStats, reboundNetPerTrade, reboundProfitStats, reboundBestTradeStats, reboundEarlyStopRateClosed)
vwapReclaimStatsGateOk = f_stats_gate_ok(vwapReclaimWinRateStats, vwapReclaimClosedStats, vwapReclaimNetPerTrade, vwapReclaimProfitStats, vwapReclaimBestTradeStats, vwapReclaimEarlyStopRateClosed)
openingStatsGateOk = f_stats_gate_ok(openingWinRate, openingClosedTrades, openingNetPerTrade, openingProfit, openingBestTradeStats, openingEarlyStopRateClosed)
buyCleanExecutable = buyClean
buyPlusExecutable = buyPlus
showPbPlusExecutable = showPbPlus
pbRecoveryBuyExecutable = pbRecoveryBuy
showFastMomentumExecutable = showFastMomentum
showFastEarlyExecutable = showFastEarly
showTenMinTurnExecutable = showTenMinTurn
showEarlyReboundExecutable = showEarlyRebound
showVwapReclaimExecutable = showVwapReclaim
showOpeningDriveExceptionExecutable = showOpeningDriveException
teamEntryExecutableBase = enableWebhookAlerts and barstate.isconfirmed and not chopBlockActive
buyCleanStatsBlocked = buyClean and not buyStatsGateOk
buyPlusStatsBlocked = buyPlus and not buyPlusStatsGateOk
showPbPlusStatsBlocked = showPbPlus and not pbPlusStatsGateOk
pbRecoveryBuyStatsBlocked = pbRecoveryBuy and not rallyStatsGateOk
showFastMomentumStatsBlocked = showFastMomentum and not fastStatsGateOk
showFastEarlyStatsBlocked = showFastEarly and not fastEarlyStatsGateOk
showTenMinTurnStatsBlocked = showTenMinTurn and not turnStatsGateOk
showEarlyReboundStatsBlocked = showEarlyRebound and not reboundStatsGateOk
showVwapReclaimStatsBlocked = showVwapReclaim and not vwapReclaimStatsGateOk
showOpeningDriveExceptionStatsBlocked = showOpeningDriveException and not openingStatsGateOk

selectedClosedStats = selectedWClosed
selectedWinRateStats = selectedWClosed > 0 ? (selectedWWins * 1.0 / selectedWClosed) * 100 : 0.0
selectedProfitStats = selectedWNet
selectedEntryStats = selectedWEntries
selectedEarlyStopStats = selectedWStops
selectedEarlyStopRate = selectedEntryStats > 0 ? (selectedEarlyStopStats * 1.0 / selectedEntryStats) * 100 : 0.0
selectedSurvivedStats = selectedWSurvived
selectedSurvivedProfitStats = selectedWSurvivedProfit
selectedQualityScore = f_quality_score(selectedWinRateStats, selectedProfitStats, selectedSurvivedProfitStats, selectedEarlyStopRate, selectedClosedStats)

teamClosedStats = (buyStatsGateOk ? buyClosedStats : 0) + (buyPlusStatsGateOk ? buyPlusClosedStats : 0) + (pbPlusStatsGateOk ? pbPlusClosedStats : 0) + (rallyStatsGateOk ? rallyClosedStats : 0) + (fastStatsGateOk ? fastClosedStats : 0) + (fastEarlyStatsGateOk ? fastEarlyClosedStats : 0) + (turnStatsGateOk ? turnClosedStats : 0) + (reboundStatsGateOk ? reboundClosedStats : 0) + (vwapReclaimStatsGateOk ? vwapReclaimClosedStats : 0) + (openingStatsGateOk ? openingClosedTrades : 0)
teamQualityWeighted = (buyStatsGateOk ? buyQualityScore * buyClosedStats : 0) + (buyPlusStatsGateOk ? buyPlusQualityScore * buyPlusClosedStats : 0) + (pbPlusStatsGateOk ? pbPlusQualityScore * pbPlusClosedStats : 0) + (rallyStatsGateOk ? rallyQualityScore * rallyClosedStats : 0) + (fastStatsGateOk ? fastQualityScore * fastClosedStats : 0) + (fastEarlyStatsGateOk ? fastEarlyQualityScore * fastEarlyClosedStats : 0) + (turnStatsGateOk ? turnQualityScore * turnClosedStats : 0) + (reboundStatsGateOk ? reboundQualityScore * reboundClosedStats : 0) + (vwapReclaimStatsGateOk ? vwapReclaimQualityScore * vwapReclaimClosedStats : 0) + (openingStatsGateOk ? openingQualityScore * openingClosedTrades : 0)
teamQualityScore = teamClosedStats > 0 ? int(math.round(teamQualityWeighted / teamClosedStats)) : 0
teamProfitStats = (buyStatsGateOk ? buyProfitStats : 0.0) + (buyPlusStatsGateOk ? buyPlusProfitStats : 0.0) + (pbPlusStatsGateOk ? pbPlusProfitStats : 0.0) + (rallyStatsGateOk ? rallyProfitStats : 0.0) + (fastStatsGateOk ? fastProfitStats : 0.0) + (fastEarlyStatsGateOk ? fastEarlyProfitStats : 0.0) + (turnStatsGateOk ? turnProfitStats : 0.0) + (reboundStatsGateOk ? reboundProfitStats : 0.0) + (vwapReclaimStatsGateOk ? vwapReclaimProfitStats : 0.0) + (openingStatsGateOk ? openingProfit : 0.0)
teamEntryStats = (buyStatsGateOk ? buyEntryStats : 0) + (buyPlusStatsGateOk ? buyPlusEntryStats : 0) + (pbPlusStatsGateOk ? pbPlusEntryStats : 0) + (rallyStatsGateOk ? rallyEntryStats : 0) + (fastStatsGateOk ? fastEntryStats : 0) + (fastEarlyStatsGateOk ? fastEarlyEntryStats : 0) + (turnStatsGateOk ? turnEntryStats : 0) + (reboundStatsGateOk ? reboundEntryStats : 0) + (vwapReclaimStatsGateOk ? vwapReclaimEntryStats : 0) + (openingStatsGateOk ? openingEntryStats : 0)
teamEarlyStopStats = (buyStatsGateOk ? buyEarlyStopStats : 0) + (buyPlusStatsGateOk ? buyPlusEarlyStopStats : 0) + (pbPlusStatsGateOk ? pbPlusEarlyStopStats : 0) + (rallyStatsGateOk ? rallyEarlyStopStats : 0) + (fastStatsGateOk ? fastEarlyStopStats : 0) + (fastEarlyStatsGateOk ? fastEarlyEarlyStopStats : 0) + (turnStatsGateOk ? turnEarlyStopStats : 0) + (reboundStatsGateOk ? reboundEarlyStopStats : 0) + (vwapReclaimStatsGateOk ? vwapReclaimEarlyStopStats : 0) + (openingStatsGateOk ? openingEarlyStopStats : 0)
teamEarlyStopRate = teamEntryStats > 0 ? (teamEarlyStopStats * 1.0 / teamEntryStats) * 100 : 0.0
teamSurvivedStats = (buyStatsGateOk ? buySurvivedStats : 0) + (buyPlusStatsGateOk ? buyPlusSurvivedStats : 0) + (pbPlusStatsGateOk ? pbPlusSurvivedStats : 0) + (rallyStatsGateOk ? rallySurvivedStats : 0) + (fastStatsGateOk ? fastSurvivedStats : 0) + (fastEarlyStatsGateOk ? fastEarlySurvivedStats : 0) + (turnStatsGateOk ? turnSurvivedStats : 0) + (reboundStatsGateOk ? reboundSurvivedStats : 0) + (vwapReclaimStatsGateOk ? vwapReclaimSurvivedStats : 0) + (openingStatsGateOk ? openingSurvivedStats : 0)
teamSurvivedProfitStats = (buyStatsGateOk ? buySurvivedProfitStats : 0.0) + (buyPlusStatsGateOk ? buyPlusSurvivedProfitStats : 0.0) + (pbPlusStatsGateOk ? pbPlusSurvivedProfitStats : 0.0) + (rallyStatsGateOk ? rallySurvivedProfitStats : 0.0) + (fastStatsGateOk ? fastSurvivedProfitStats : 0.0) + (fastEarlyStatsGateOk ? fastEarlySurvivedProfitStats : 0.0) + (turnStatsGateOk ? turnSurvivedProfitStats : 0.0) + (reboundStatsGateOk ? reboundSurvivedProfitStats : 0.0) + (vwapReclaimStatsGateOk ? vwapReclaimSurvivedProfitStats : 0.0) + (openingStatsGateOk ? openingSurvivedProfitStats : 0.0)

totalClosedStats = buyClosedStats + buyPlusClosedStats + pbPlusClosedStats + rallyClosedStats + fastClosedStats + fastEarlyClosedStats + turnClosedStats + reboundClosedStats + vwapReclaimClosedStats + openingClosedTrades
totalQualityWeighted = (buyQualityScore * buyClosedStats) + (buyPlusQualityScore * buyPlusClosedStats) + (pbPlusQualityScore * pbPlusClosedStats) + (rallyQualityScore * rallyClosedStats) + (fastQualityScore * fastClosedStats) + (fastEarlyQualityScore * fastEarlyClosedStats) + (turnQualityScore * turnClosedStats) + (reboundQualityScore * reboundClosedStats) + (vwapReclaimQualityScore * vwapReclaimClosedStats) + (openingQualityScore * openingClosedTrades)
totalQualityScore = totalClosedStats > 0 ? int(math.round(totalQualityWeighted / totalClosedStats)) : 0
totalProfitStats = buyProfitStats + buyPlusProfitStats + pbPlusProfitStats + rallyProfitStats + fastProfitStats + fastEarlyProfitStats + turnProfitStats + reboundProfitStats + vwapReclaimProfitStats + openingProfit
totalEntryStats = buyEntryStats + buyPlusEntryStats + pbPlusEntryStats + rallyEntryStats + fastEntryStats + fastEarlyEntryStats + turnEntryStats + reboundEntryStats + vwapReclaimEntryStats + openingEntryStats
totalEarlyStopStats = buyEarlyStopStats + buyPlusEarlyStopStats + pbPlusEarlyStopStats + rallyEarlyStopStats + fastEarlyStopStats + fastEarlyEarlyStopStats + turnEarlyStopStats + reboundEarlyStopStats + vwapReclaimEarlyStopStats + openingEarlyStopStats
totalEarlyStopRate = totalEntryStats > 0 ? (totalEarlyStopStats * 1.0 / totalEntryStats) * 100 : 0.0
totalSurvivedStats = buySurvivedStats + buyPlusSurvivedStats + pbPlusSurvivedStats + rallySurvivedStats + fastSurvivedStats + fastEarlySurvivedStats + turnSurvivedStats + reboundSurvivedStats + vwapReclaimSurvivedStats + openingSurvivedStats
totalSurvivedProfitStats = buySurvivedProfitStats + buyPlusSurvivedProfitStats + pbPlusSurvivedProfitStats + rallySurvivedProfitStats + fastSurvivedProfitStats + fastEarlySurvivedProfitStats + turnSurvivedProfitStats + reboundSurvivedProfitStats + vwapReclaimSurvivedProfitStats + openingSurvivedProfitStats

selectedAvgProfitStats = selectedClosedStats > 0 ? selectedProfitStats / selectedClosedStats : 0.0
totalAvgProfitStats = totalClosedStats > 0 ? totalProfitStats / totalClosedStats : 0.0
selectedAvgRunStats = selectedSurvivedStats > 0 ? selectedSurvivedProfitStats / selectedSurvivedStats : 0.0
teamAvgProfitStats = teamClosedStats > 0 ? teamProfitStats / teamClosedStats : 0.0
teamAvgRunStats = teamSurvivedStats > 0 ? teamSurvivedProfitStats / teamSurvivedStats : 0.0

f_range_score(x, lo, hi) =>
    hi == lo ? 0.0 : f_clamp((x - lo) / (hi - lo) * 100, 0, 100)

f_timeframe_penalty(tfMinutes) =>
    tfMinutes <= 30 ? 0.0 : tfMinutes <= 45 ? 3.0 : tfMinutes <= 60 ? 6.0 : tfMinutes <= 120 ? 12.0 : tfMinutes <= 180 ? 18.0 : tfMinutes <= 300 ? 25.0 : 35.0

f_pb_auto_fit_score(q, avgProfit, avgRun, earlyStopRate, sampleCount, selectedAvg, totalAvg, tfMinutes) =>
    float qComponent = f_clamp(q, 0, 100)
    float avgProfitComponent = f_range_score(avgProfit, 0.2, 3.0)
    float avgRunComponent = f_range_score(avgRun, 1.0, 10.0)
    float stopComponent = f_clamp(100 - earlyStopRate, 0, 100)
    float sampleComponent = sampleCount >= 200 ? 100 : sampleCount >= 100 ? 90 : sampleCount >= 50 ? 80 : sampleCount >= 25 ? 65 : sampleCount >= 10 ? 50 : 25
    float selectedEdgeComponent = totalAvg > 0 ? f_clamp(50 + ((selectedAvg - totalAvg) * 10), 0, 100) : 50
    float rawScore = (qComponent * 0.25) + (avgProfitComponent * 0.30) + (avgRunComponent * 0.20) + (stopComponent * 0.10) + (sampleComponent * 0.10) + (selectedEdgeComponent * 0.05)
    int(math.round(f_clamp(rawScore - f_timeframe_penalty(tfMinutes), 0, 100)))

tfMinutesForAutoFit = timeframe.in_seconds(timeframe.period) / 60.0
pbAutoFitScore = f_pb_auto_fit_score(teamQualityScore, teamAvgProfitStats, teamAvgRunStats, teamEarlyStopRate, teamClosedStats, teamAvgProfitStats, totalAvgProfitStats, tfMinutesForAutoFit)
pbAutoFitLabel = pbAutoFitScore >= 90 ? "Elite" : pbAutoFitScore >= 80 ? "Fit" : pbAutoFitScore >= 70 ? "Watch" : "No"
pbAutoFitColor = pbAutoFitScore >= 80 ? color.lime : pbAutoFitScore >= 70 ? color.yellow : color.red
pbAutoFitBg = pbAutoFitScore >= 80 ? color.rgb(14, 92, 54) : pbAutoFitScore >= 70 ? color.rgb(90, 80, 20) : color.rgb(92, 30, 36)

// === Plots ===
