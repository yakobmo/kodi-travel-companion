plotshape(showTenMinTurnStatsBlocked, title="TURN Stats Blocked", location=location.abovebar, style=shape.xcross, text="TURN X", color=color.red, textcolor=color.red, size=size.small)
plotshape(showEarlyReboundStatsBlocked, title="REB Stats Blocked", location=location.abovebar, style=shape.xcross, text="REB X", color=color.red, textcolor=color.red, size=size.small)
plotshape(showVwapReclaimStatsBlocked, title="RS Pullback Stats Blocked", location=location.abovebar, style=shape.xcross, text="RS X", color=color.red, textcolor=color.red, size=size.small)
plotshape(showOpeningDriveExceptionStatsBlocked, title="RS PB+ Stats Blocked", location=location.abovebar, style=shape.xcross, text="RS+ X", color=color.red, textcolor=color.red, size=size.small)

if isAnySignal
    label.new(bar_index, high, text="Score: " + str.tostring(finalScore, "#"), color=color.new(color.black, 100), textcolor=color.yellow, style=label.style_label_down, yloc=yloc.abovebar)

// === RUNNER & EXIT LOGIC ===
var float[] entryPrices = array.new_float()
var float[] highestPrices = array.new_float()
var int[] entryBars = array.new_int()
var string[] entryTypes = array.new_string()
var string[] entryIds = array.new_string()
var int[] entryTimes = array.new_int()
var bool[] runnerActive = array.new_bool()
var bool[] checkPointMarked = array.new_bool()
var bool[] redDuringHold = array.new_bool()

string[] pendingEntrySignals = array.new_string()
string[] pendingEntryTypes = array.new_string()
string[] pendingEntryIds = array.new_string()
float[] pendingEntryPrices = array.new_float()
int[] pendingEntryTimes = array.new_int()
int[] pendingEntryBars = array.new_int()

if teamEntryExecutableBase
    if buyCleanExecutable and alertMainSignals
        string buyEntryId = syminfo.tickerid + "|BUY|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "BUY")
        array.push(pendingEntryTypes, "BUY")
        array.push(pendingEntryIds, buyEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if buyPlusExecutable and alertMainSignals
        string buyPlusEntryId = syminfo.tickerid + "|BUY_PLUS|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "BUY_PLUS")
        array.push(pendingEntryTypes, "BUY_PLUS")
        array.push(pendingEntryIds, buyPlusEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if showPbPlusExecutable and alertMainSignals
        string pbPlusEntryId = syminfo.tickerid + "|PB_PLUS|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "PB_PLUS")
        array.push(pendingEntryTypes, "PB_PLUS")
        array.push(pendingEntryIds, pbPlusEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if pbRecoveryBuyExecutable and alertRecoverySignals
        string rallyEntryId = syminfo.tickerid + "|RALLY_BUY|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "RALLY_RECOVERY_PB")
        array.push(pendingEntryTypes, "RALLY_BUY")
        array.push(pendingEntryIds, rallyEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if showFastMomentumExecutable and alertMainSignals
        string fastEntryId = syminfo.tickerid + "|FAST_MOMENTUM_BUY|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "FAST_MOMENTUM_BUY")
        array.push(pendingEntryTypes, "FAST_MOMENTUM_BUY")
        array.push(pendingEntryIds, fastEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if showFastEarlyExecutable and alertMainSignals
        string fastEarlyEntryId = syminfo.tickerid + "|FAST_EARLY_BUY|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "FAST_EARLY_BUY")
        array.push(pendingEntryTypes, "FAST_EARLY_BUY")
        array.push(pendingEntryIds, fastEarlyEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if showTenMinTurnExecutable and alertMainSignals
        string turnEntryId = syminfo.tickerid + "|TEN_MIN_TURN_BUY|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "TEN_MIN_TURN_BUY")
        array.push(pendingEntryTypes, "TEN_MIN_TURN_BUY")
        array.push(pendingEntryIds, turnEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if showEarlyReboundExecutable and alertMainSignals
        string reboundEntryId = syminfo.tickerid + "|EARLY_REBOUND_BUY|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "EARLY_REBOUND_BUY")
        array.push(pendingEntryTypes, "EARLY_REBOUND_BUY")
        array.push(pendingEntryIds, reboundEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if showVwapReclaimExecutable and alertMainSignals
        string vwapReclaimEntryId = syminfo.tickerid + "|VWAP_RECLAIM_BUY|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "VWAP_RECLAIM_BUY")
        array.push(pendingEntryTypes, "VWAP_RECLAIM_BUY")
        array.push(pendingEntryIds, vwapReclaimEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)
    if showOpeningDriveExceptionExecutable and alertOpeningDriveSignals
        string openEntryId = syminfo.tickerid + "|OPENING_RANGE_RECLAIM|" + str.tostring(time) + "|" + str.tostring(bar_index)
        array.push(pendingEntrySignals, "OPENING_RANGE_RECLAIM")
        array.push(pendingEntryTypes, "OPENING_RANGE_RECLAIM")
        array.push(pendingEntryIds, openEntryId)
        array.push(pendingEntryPrices, close)
        array.push(pendingEntryTimes, time)
        array.push(pendingEntryBars, bar_index)

int pendingEntryCount = array.size(pendingEntrySignals)

string exitTypeToSignal = ""
float atrExitStopPrice = na
string atrExitMode = ""
string[] pendingAlertSignals = array.new_string()
string[] pendingAlertEntryIds = array.new_string()
string[] pendingAlertEntryTypes = array.new_string()
float[] pendingAlertEntryPrices = array.new_float()
int[] pendingAlertEntryTimes = array.new_int()
int[] pendingAlertEntryBars = array.new_int()
float[] pendingAlertExitPrices = array.new_float()
float[] pendingAlertExitProfitPcts = array.new_float()
float[] pendingAlertStopPrices = array.new_float()
string[] pendingAlertModes = array.new_string()

trendStillStrong = close > ema8 and ema8 > ema8[1] and rsi > 45 and close > vwapVal
antiShakeoutFilter = trendStillStrong

if array.size(entryPrices) > 0
    for i = array.size(entryPrices) - 1 to 0
        float ePrice = array.get(entryPrices, i)
        float hPrice = math.max(array.get(highestPrices, i), high)
        array.set(highestPrices, i, hPrice)
        int bIndex = array.get(entryBars, i)
        int barsIn = bar_index - bIndex
        string thisEntryType = array.get(entryTypes, i)
        string thisEntryId = array.get(entryIds, i)
        string thisMarketContext = array.get(entryMarketContexts, i)
        int thisEntryTime = array.get(entryTimes, i)
        float maxRun = ((hPrice - ePrice) / ePrice) * 100
        float currentGainGross = ((close - ePrice) / ePrice) * 100
        float currentGain = currentGainGross - estRoundTripCostPct
        bool isRunner = array.get(runnerActive, i) or maxRun >= runnerTriggerPct
        array.set(runnerActive, i, isRunner)
        bool thisRedDuringHold = array.get(redDuringHold, i) or isMarketRiskOff
        array.set(redDuringHold, i, thisRedDuringHold)

        float earlyStop = ePrice - (early_atr_mult * atr14)
        float runnerStop = hPrice * (1 - trailStopPct / 100)
        bool earlyExit = not isRunner and close < earlyStop
        bool runnerExit = isRunner and close < runnerStop
        bool openingOperationalTimeout = (thisEntryType == "OPENING_RANGE_RECLAIM" or thisEntryType == "OPENING_DRIVE_EXCEPTION") and barsIn >= openingStatsTimeoutBars
        bool checkPointTimeout = enableCheckPoint and barsIn >= checkPointBars and currentGain < checkPointMaxGainPct

        if (earlyExit or runnerExit) and barstate.isconfirmed and inExecutableExitSession
            exitTypeToSignal := thisEntryType + (earlyExit ? "_EARLY_ATR_STOP" : "_ATR_EXIT")
            atrExitStopPrice := earlyExit ? earlyStop : runnerStop
            atrExitMode := earlyExit ? "EARLY_PROTECTION" : "RUNNER_ATR"
            float selectedExitPrice = close
            float selectedProfitPctGross = ((selectedExitPrice - ePrice) / ePrice) * 100
            float selectedProfitPct = selectedProfitPctGross - estRoundTripCostPct
            array.push(pendingAlertSignals, exitTypeToSignal)
            array.push(pendingAlertEntryIds, thisEntryId)
            array.push(pendingAlertEntryTypes, thisEntryType)
            array.push(pendingAlertEntryPrices, ePrice)
            array.push(pendingAlertEntryTimes, thisEntryTime)
            array.push(pendingAlertEntryBars, bIndex)
            array.push(pendingAlertExitPrices, selectedExitPrice)
            array.push(pendingAlertExitProfitPcts, selectedProfitPct)
            array.push(pendingAlertStopPrices, atrExitStopPrice)
            array.push(pendingAlertModes, atrExitMode)
            selectedProfitStatsAuto += selectedProfitPct
            selectedClosedStatsAuto += 1
            array.push(selectedWindowExitTimes, time)
            array.push(selectedWindowProfitPcts, selectedProfitPct)
            array.push(selectedWindowEarlyStopFlags, earlyExit)
            if selectedProfitPct > 0
                selectedWinsStatsAuto += 1
            if earlyExit
                selectedEarlyStopStatsAuto += 1
            else
                selectedSurvivedStatsAuto += 1
                selectedSurvivedProfitStatsAuto += selectedProfitPct
            if thisMarketContext == "SUPPORT"
                teamContextSupportClosed += 1
                teamContextSupportProfit += selectedProfitPct
                if selectedProfitPct > 0
                    teamContextSupportWins += 1
                if earlyExit
                    teamContextSupportStops += 1
            else if thisMarketContext == "WEAK"
                teamContextWeakClosed += 1
                teamContextWeakProfit += selectedProfitPct
                if selectedProfitPct > 0
                    teamContextWeakWins += 1
                if earlyExit
                    teamContextWeakStops += 1
            else
                teamContextNeutralClosed += 1
                teamContextNeutralProfit += selectedProfitPct
                if selectedProfitPct > 0
                    teamContextNeutralWins += 1
                if earlyExit
                    teamContextNeutralStops += 1

            label.new(bar_index, high + atr14, earlyExit ? "EARLY ATR STOP" : "TRAIL EXIT", color=color.red, textcolor=color.white, size=size.small)
            array.remove(entryPrices, i)
            array.remove(highestPrices, i)
            array.remove(entryBars, i)
            array.remove(entryTypes, i)
            array.remove(entryIds, i)
            array.remove(entryMarketContexts, i)
            array.remove(entryTimes, i)
            array.remove(runnerActive, i)
            array.remove(checkPointMarked, i)
            array.remove(redDuringHold, i)
        else if (checkPointTimeout or openingOperationalTimeout) and not array.get(checkPointMarked, i) and barstate.isconfirmed and inExecutableExitSession
            float checkPointExitPrice = close
            array.push(pendingAlertSignals, openingOperationalTimeout ? thisEntryType + "_TIME_EXIT" : "FALSE_BREAKOUT")
            array.push(pendingAlertEntryIds, thisEntryId)
            array.push(pendingAlertEntryTypes, thisEntryType)
            array.push(pendingAlertEntryPrices, ePrice)
            array.push(pendingAlertEntryTimes, thisEntryTime)
            array.push(pendingAlertEntryBars, bIndex)
            array.push(pendingAlertExitPrices, checkPointExitPrice)
            array.push(pendingAlertExitProfitPcts, currentGain)
            array.push(pendingAlertStopPrices, na)
            array.push(pendingAlertModes, openingOperationalTimeout ? "OPENING_STATS_TIMEOUT" : "CHECK_POINT_TIMEOUT")
            if enableFalseSignalPressure and checkPointTimeout
                array.push(falsePressureTimes, time)
                array.push(falsePressureProfitPcts, currentGain)
                array.push(falsePressureFalseFlags, true)
                array.push(falsePressureRedMarketFlags, thisRedDuringHold)
                array.push(falsePressureEarlyStopFlags, false)
                array.push(falsePressureTypes, thisEntryType)
            selectedProfitStatsAuto += currentGain
            selectedClosedStatsAuto += 1
            array.push(selectedWindowExitTimes, time)
            array.push(selectedWindowProfitPcts, currentGain)
            array.push(selectedWindowEarlyStopFlags, true)
            if currentGain > 0
                selectedWinsStatsAuto += 1
            selectedEarlyStopStatsAuto += 1
            if thisMarketContext == "SUPPORT"
                teamContextSupportClosed += 1
                teamContextSupportProfit += currentGain
                if currentGain > 0
                    teamContextSupportWins += 1
                teamContextSupportStops += 1
            else if thisMarketContext == "WEAK"
                teamContextWeakClosed += 1
                teamContextWeakProfit += currentGain
                if currentGain > 0
                    teamContextWeakWins += 1
                teamContextWeakStops += 1
            else
                teamContextNeutralClosed += 1
                teamContextNeutralProfit += currentGain
                if currentGain > 0
                    teamContextNeutralWins += 1
                teamContextNeutralStops += 1
            label.new(bar_index, high + atr14, "STALL EXIT", color=color.orange, textcolor=color.black, size=size.small)
            array.remove(entryPrices, i)
            array.remove(highestPrices, i)
            array.remove(entryBars, i)
            array.remove(entryTypes, i)
            array.remove(entryIds, i)
            array.remove(entryMarketContexts, i)
            array.remove(entryTimes, i)
            array.remove(runnerActive, i)
            array.remove(checkPointMarked, i)
            array.remove(redDuringHold, i)

int falsePressureCutoffTime = time - (falsePressureLookbackDays * 86400000)
if array.size(falsePressureTimes) > 0
    for fp = array.size(falsePressureTimes) - 1 to 0
        if array.get(falsePressureTimes, fp) < falsePressureCutoffTime
            array.remove(falsePressureTimes, fp)
            array.remove(falsePressureProfitPcts, fp)
            array.remove(falsePressureFalseFlags, fp)
            array.remove(falsePressureRedMarketFlags, fp)
            array.remove(falsePressureEarlyStopFlags, fp)
            array.remove(falsePressureTypes, fp)

int falsePressureClosedRecent = 0
int falsePressureLossRecent = 0
int falsePressureFalseRecent = 0
int falsePressureRedRecent = 0
float falsePressureNetRecent = 0.0
float falsePressureGrossWin = 0.0
float falsePressureGrossLoss = 0.0
int buyGuardRemoved = buyWGuardRemoved
float buyGuardRemovedNet = buyWGuardRemovedNet
int buyGuardRemovedStops = buyWGuardRemovedStops
int buyGuardRemovedRuns = buyWGuardRemovedRuns
float buyGuardRemovedRunNet = buyWGuardRemovedRunNet
int buyPlusGuardRemoved = buyPlusWGuardRemoved
float buyPlusGuardRemovedNet = buyPlusWGuardRemovedNet
int buyPlusGuardRemovedStops = buyPlusWGuardRemovedStops
int buyPlusGuardRemovedRuns = buyPlusWGuardRemovedRuns
float buyPlusGuardRemovedRunNet = buyPlusWGuardRemovedRunNet
int pbPlusGuardRemoved = pbPlusWGuardRemoved
float pbPlusGuardRemovedNet = pbPlusWGuardRemovedNet
int pbPlusGuardRemovedStops = pbPlusWGuardRemovedStops
int pbPlusGuardRemovedRuns = pbPlusWGuardRemovedRuns
float pbPlusGuardRemovedRunNet = pbPlusWGuardRemovedRunNet
int rallyGuardRemoved = rallyWGuardRemoved
float rallyGuardRemovedNet = rallyWGuardRemovedNet
int rallyGuardRemovedStops = rallyWGuardRemovedStops
int rallyGuardRemovedRuns = rallyWGuardRemovedRuns
float rallyGuardRemovedRunNet = rallyWGuardRemovedRunNet
int fastGuardRemoved = fastWGuardRemoved
float fastGuardRemovedNet = fastWGuardRemovedNet
int fastGuardRemovedStops = fastWGuardRemovedStops
int fastGuardRemovedRuns = fastWGuardRemovedRuns
float fastGuardRemovedRunNet = fastWGuardRemovedRunNet
int turnGuardRemoved = turnWGuardRemoved
float turnGuardRemovedNet = turnWGuardRemovedNet
int turnGuardRemovedStops = turnWGuardRemovedStops
int turnGuardRemovedRuns = turnWGuardRemovedRuns
float turnGuardRemovedRunNet = turnWGuardRemovedRunNet
int reboundGuardRemoved = reboundWGuardRemoved
float reboundGuardRemovedNet = reboundWGuardRemovedNet
int reboundGuardRemovedStops = reboundWGuardRemovedStops
int reboundGuardRemovedRuns = reboundWGuardRemovedRuns
float reboundGuardRemovedRunNet = reboundWGuardRemovedRunNet
int openingGuardRemoved = openingWGuardRemoved
float openingGuardRemovedNet = openingWGuardRemovedNet
int openingGuardRemovedStops = openingWGuardRemovedStops
int openingGuardRemovedRuns = openingWGuardRemovedRuns
float openingGuardRemovedRunNet = openingWGuardRemovedRunNet

f_false_pressure_weakest_keys() =>
    string[] fpKeys = array.new_string()
    float[] fpWeak = array.new_float()
    array.push(fpKeys, "BUY")
    array.push(fpWeak, buyQualityFail ? (100 - buyQualityScore) * 100 - buyNetPerTrade : -999999.0)
    array.push(fpKeys, "BUY_PLUS")
    array.push(fpWeak, buyPlusQualityFail ? (100 - buyPlusQualityScore) * 100 - buyPlusNetPerTrade : -999999.0)
    array.push(fpKeys, "PB_PLUS")
    array.push(fpWeak, pbPlusQualityFail ? (100 - pbPlusQualityScore) * 100 - pbPlusNetPerTrade : -999999.0)
    array.push(fpKeys, "RALLY")
    array.push(fpWeak, rallyQualityFail ? (100 - rallyQualityScore) * 100 - rallyNetPerTrade : -999999.0)
    array.push(fpKeys, "FAST")
    array.push(fpWeak, fastQualityFail ? (100 - fastQualityScore) * 100 - fastNetPerTrade : -999999.0)
    array.push(fpKeys, "FAST_EARLY")
    array.push(fpWeak, fastEarlyQualityFail ? (100 - fastEarlyQualityScore) * 100 - fastEarlyNetPerTrade : -999999.0)
    array.push(fpKeys, "TURN")
    array.push(fpWeak, turnQualityFail ? (100 - turnQualityScore) * 100 - turnNetPerTrade : -999999.0)
    array.push(fpKeys, "EARLY_REBOUND_BUY")
    array.push(fpWeak, reboundQualityFail ? (100 - reboundQualityScore) * 100 - reboundNetPerTrade : -999999.0)
    array.push(fpKeys, "VWAP_RECLAIM")
    array.push(fpWeak, vwapReclaimQualityFail ? (100 - vwapReclaimQualityScore) * 100 - vwapReclaimNetPerTrade : -999999.0)
    array.push(fpKeys, "OPEN")
    array.push(fpWeak, openingQualityFail ? (100 - openingQualityScore) * 100 - openingNetPerTrade : -999999.0)
    string weakestKey1 = ""
    float weakestScore1 = -999999.0
    string weakestKey2 = ""
    float weakestScore2 = -999999.0
    for wk = 0 to array.size(fpKeys) - 1
        float wScore = array.get(fpWeak, wk)
        string wKey = array.get(fpKeys, wk)
        if wScore > weakestScore1
            weakestKey2 := weakestKey1
            weakestScore2 := weakestScore1
            weakestKey1 := wKey
            weakestScore1 := wScore
        else if wScore > weakestScore2
            weakestKey2 := wKey
            weakestScore2 := wScore
    [weakestScore1 > -999999.0 ? weakestKey1 : "", weakestScore2 > -999999.0 ? weakestKey2 : ""]

[falsePressureWeakKey1, falsePressureWeakKey2] = f_false_pressure_weakest_keys()

if array.size(falsePressureTimes) > 0
    for fp = 0 to array.size(falsePressureTimes) - 1
        string fpKeyForExclusion = f_window_key(array.get(falsePressureTypes, fp))
        bool fpExcludedWeakTactic = (falsePressureWeakKey1 != "" and fpKeyForExclusion == falsePressureWeakKey1) or (falsePressureWeakKey2 != "" and fpKeyForExclusion == falsePressureWeakKey2)
        if not fpExcludedWeakTactic
            float fpProfit = array.get(falsePressureProfitPcts, fp)
            bool fpIsFalse = array.get(falsePressureFalseFlags, fp)
            bool fpIsRedMarket = array.get(falsePressureRedMarketFlags, fp)
            falsePressureClosedRecent += 1
            falsePressureNetRecent += fpProfit
            if fpProfit < 0
                falsePressureLossRecent += 1
                falsePressureGrossLoss += math.abs(fpProfit)
            else
                falsePressureGrossWin += fpProfit
            if fpIsFalse
                falsePressureFalseRecent += 1
            if fpIsRedMarket
                falsePressureRedRecent += 1

f_false_pressure_score(int closedRecent, int lossRecent, int falseRecent, int redRecent, float netRecent, float grossWin, float grossLoss) =>
    float lossRate = closedRecent > 0 ? (lossRecent * 100.0 / closedRecent) : 0.0
    float falseRate = closedRecent > 0 ? (falseRecent * 100.0 / closedRecent) : 0.0
    float redRate = closedRecent > 0 ? (redRecent * 100.0 / closedRecent) : 0.0
    float pf = f_profit_factor(grossWin, grossLoss)
    float pfComponent = pf >= 1.5 ? 0.0 : f_clamp((1.5 - pf) / 1.5 * 100.0, 0, 100)
    float netComponent = netRecent >= 0 ? 0.0 : f_clamp(math.abs(netRecent) * 4.0, 0, 100)
    float rawScore = f_clamp((lossRate * 0.35) + (falseRate * 0.15) + (redRate * 0.10) + (pfComponent * 0.30) + (netComponent * 0.10), 0, 100)
    rawScore * f_sample_factor(closedRecent)

float falsePressureScore = f_false_pressure_score(falsePressureClosedRecent, falsePressureLossRecent, falsePressureFalseRecent, falsePressureRedRecent, falsePressureNetRecent, falsePressureGrossWin, falsePressureGrossLoss)
float falsePressureProfitFactor = f_profit_factor(falsePressureGrossWin, falsePressureGrossLoss)

var bool falsePressureLatched = false
falsePressureEnterScore = 60.0
falsePressureExitScore = 30.0
bool falsePressureCleanSweep = falsePressureClosedRecent >= 4 and falsePressureLossRecent == falsePressureClosedRecent
if not enableFalseSignalPressure
    falsePressureLatched := false
else if falsePressureCleanSweep or falsePressureScore >= falsePressureEnterScore
    falsePressureLatched := true
else if falsePressureScore < falsePressureExitScore
    falsePressureLatched := false

string falsePressureLabel = not enableFalseSignalPressure ? "OFF" : falsePressureLatched ? "BLOCK" : falsePressureScore >= falsePressureExitScore ? "WATCH" : "CLEAN"
color falsePressureBg = not enableFalseSignalPressure ? color.rgb(70, 70, 70) : falsePressureLatched ? color.rgb(120, 28, 32) : falsePressureScore >= falsePressureExitScore ? color.rgb(92, 76, 18) : color.rgb(18, 76, 45)
bool falsePressureAutoBlocked = falsePressureBlockAuto and falsePressureLatched

[selectedCurrentEntries, selectedCurrentClosed, selectedCurrentWins, selectedCurrentNet, selectedCurrentStops, selectedCurrentSurvived, selectedCurrentSurvivedProfit] = f_selected_window_metrics()
selectedClosedStats := selectedCurrentClosed
selectedWinRateStats := selectedCurrentClosed > 0 ? (selectedCurrentWins * 1.0 / selectedCurrentClosed) * 100 : 0.0
selectedProfitStats := selectedCurrentNet
selectedEntryStats := selectedCurrentEntries
selectedEarlyStopStats := selectedCurrentStops
selectedEarlyStopRate := selectedEntryStats > 0 ? (selectedEarlyStopStats * 1.0 / selectedEntryStats) * 100 : 0.0
selectedSurvivedStats := selectedCurrentSurvived
selectedSurvivedProfitStats := selectedCurrentSurvivedProfit
selectedQualityScore := f_quality_score(selectedWinRateStats, selectedProfitStats, selectedSurvivedProfitStats, selectedEarlyStopRate, selectedClosedStats)
selectedAvgProfitStats := selectedClosedStats > 0 ? selectedProfitStats / selectedClosedStats : 0.0
selectedAvgRunStats := selectedSurvivedStats > 0 ? selectedSurvivedProfitStats / selectedSurvivedStats : 0.0
teamAvgProfitStats := teamClosedStats > 0 ? teamProfitStats / teamClosedStats : 0.0
teamAvgRunStats := teamSurvivedStats > 0 ? teamSurvivedProfitStats / teamSurvivedStats : 0.0
pbAutoFitScore := f_pb_auto_fit_score(teamQualityScore, teamAvgProfitStats, teamAvgRunStats, teamEarlyStopRate, teamClosedStats, teamAvgProfitStats, totalAvgProfitStats, tfMinutesForAutoFit)
pbAutoFitLabel := pbAutoFitScore >= 90 ? "Elite" : pbAutoFitScore >= 80 ? "Fit" : pbAutoFitScore >= 70 ? "Watch" : "No"
pbAutoFitColor := pbAutoFitScore >= 80 ? color.lime : pbAutoFitScore >= 70 ? color.yellow : color.red
pbAutoFitBg := pbAutoFitScore >= 80 ? color.rgb(14, 92, 54) : pbAutoFitScore >= 70 ? color.rgb(90, 80, 20) : color.rgb(92, 30, 36)

int buyGuardClosed = f_guard_closed(buyClosedStats, buyGuardRemoved)
float buyGuardProfit = f_guard_profit(buyProfitStats, buyGuardRemovedNet)
float buyGuardWinRate = f_guard_win_rate(buyWinRateStats, buyClosedStats, buyGuardRemoved)
float buyGuardNetPerTrade = f_guard_net_per_trade(buyProfitStats, buyClosedStats, buyGuardRemoved, buyGuardRemovedNet)
float buyGuardEarlyStopRate = f_guard_stop_rate_closed(buyClosedStats, buyEarlyStopStats, buyGuardRemoved, buyGuardRemovedStops)
bool buyGuardGateOk = f_stats_gate_ok(buyGuardWinRate, buyGuardClosed, buyGuardNetPerTrade, buyGuardProfit, buyBestTradeStats, buyGuardEarlyStopRate)
int buyPlusGuardClosed = f_guard_closed(buyPlusClosedStats, buyPlusGuardRemoved)
float buyPlusGuardProfit = f_guard_profit(buyPlusProfitStats, buyPlusGuardRemovedNet)
float buyPlusGuardWinRate = f_guard_win_rate(buyPlusWinRateStats, buyPlusClosedStats, buyPlusGuardRemoved)
float buyPlusGuardNetPerTrade = f_guard_net_per_trade(buyPlusProfitStats, buyPlusClosedStats, buyPlusGuardRemoved, buyPlusGuardRemovedNet)
float buyPlusGuardEarlyStopRate = f_guard_stop_rate_closed(buyPlusClosedStats, buyPlusEarlyStopStats, buyPlusGuardRemoved, buyPlusGuardRemovedStops)
bool buyPlusGuardGateOk = f_stats_gate_ok(buyPlusGuardWinRate, buyPlusGuardClosed, buyPlusGuardNetPerTrade, buyPlusGuardProfit, buyPlusBestTradeStats, buyPlusGuardEarlyStopRate)
int pbPlusGuardClosed = f_guard_closed(pbPlusClosedStats, pbPlusGuardRemoved)
float pbPlusGuardProfit = f_guard_profit(pbPlusProfitStats, pbPlusGuardRemovedNet)
float pbPlusGuardWinRate = f_guard_win_rate(pbPlusWinRateStats, pbPlusClosedStats, pbPlusGuardRemoved)
float pbPlusGuardNetPerTrade = f_guard_net_per_trade(pbPlusProfitStats, pbPlusClosedStats, pbPlusGuardRemoved, pbPlusGuardRemovedNet)
float pbPlusGuardEarlyStopRate = f_guard_stop_rate_closed(pbPlusClosedStats, pbPlusEarlyStopStats, pbPlusGuardRemoved, pbPlusGuardRemovedStops)
bool pbPlusGuardGateOk = f_stats_gate_ok(pbPlusGuardWinRate, pbPlusGuardClosed, pbPlusGuardNetPerTrade, pbPlusGuardProfit, pbPlusBestTradeStats, pbPlusGuardEarlyStopRate)
int rallyGuardClosed = f_guard_closed(rallyClosedStats, rallyGuardRemoved)
float rallyGuardProfit = f_guard_profit(rallyProfitStats, rallyGuardRemovedNet)
float rallyGuardWinRate = f_guard_win_rate(rallyWinRateStats, rallyClosedStats, rallyGuardRemoved)
